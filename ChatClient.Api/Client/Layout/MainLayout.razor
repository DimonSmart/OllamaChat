@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject ChatClient.Application.Services.Agentic.IChatEngineSessionService AgenticChatService
@inject IUserSettingsService UserSettingsService
@inject ChatToolbarState ChatToolbar
@using ChatClient.Domain.Models
@using ChatClient.Api.Client.Pages
@using ChatClient.Api.Client.Components
@using ChatClient.Api.Services
@using ChatClient.Api.Client.Styling
@using System.Linq
@using MudX

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudXProvider />
<CascadingValue Value="@pickerModel" Name="UiModelSelection">
<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Class="application-toolbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" Size="Size.Small" />
        <MudText Typo="Typo.h6" Class="ml-3 application-toolbar__title">Ollama chat with MCP</MudText>
        @if (ActiveChatHasAgents())
        {
            <MudButton OnClick="NewChat"
                       Color="Color.Secondary"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.AddCircle"
                       Size="Size.Small"
                       Class="ml-4"
                       Style="flex-shrink: 0;">New Chat</MudButton>
        }
        @if (!isLLMAnswering)
        {
            <div class="ml-2 application-toolbar__model-picker">
                <ServerModelPicker Value="pickerModel" ValueChanged="OnModelChanged" Presentation="ServerModelPickerPresentation.Toolbar" />
            </div>
        }
        <MudSpacer />
        @if (IsOnChatPage() && ChatToolbar.IsAvailable)
        {
            @if (ChatToolbar.HasSessionState)
            {
                <MudTooltip Text="Session state">
                    <MudIconButton Icon="@Icons.Material.Filled.FactCheck"
                                   Size="Size.Small"
                                   AriaLabel="Session state"
                                   aria-expanded="@ChatToolbar.IsSessionStateOpen"
                                   Color="@(ChatToolbar.IsSessionStateOpen ? Color.Primary : Color.Default)"
                                   OnClick="ToggleSessionStateAsync" />
                </MudTooltip>
            }
            @if (ChatToolbar.HasTrace)
            {
                <MudTooltip Text="Harness trace"><MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" AriaLabel="Harness trace" aria-expanded="@ChatToolbar.IsTraceOpen" Color="@(ChatToolbar.IsTraceOpen ? Color.Primary : Color.Default)" OnClick="ToggleTraceAsync" /></MudTooltip>
            }
            <MudMenu Icon="@Icons.Material.Filled.ContentCopy" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem OnClick="@(() => ChatToolbar.CopyConversationAsync(ChatFormat.Text))">Copy as Text</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChatToolbar.CopyConversationAsync(ChatFormat.Markdown))">Copy as Markdown</MudMenuItem>
                <MudMenuItem OnClick="@(() => ChatToolbar.CopyConversationAsync(ChatFormat.Html))">Copy as HTML</MudMenuItem>
            </MudMenu>
        }
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" Size="Size.Small" />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" Size="Size.Small" />
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-13 pa-2"
                    Style="min-height: 100dvh; box-sizing: border-box; display: flex; flex-direction: column;">
        <div class="app-page-content">
            @Body
        </div>
        @if (!IsOnChatPage())
        {
            <footer class="app-footer">
                <MudContainer>
                    <MudText Align="Align.Center" Class="py-3 mud-text-secondary">
                        <small>Ollama Chat - Local LLM Chat via Ollama API</small>
                    </MudText>
                </MudContainer>
            </footer>
        }
    </MudMainContent>
</MudLayout>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">??</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool isLLMAnswering;
    private ServerModelSelection pickerModel = new(null, null);
    private MudTheme? _theme = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        AgenticChatService.AnsweringStateChanged += OnAnsweringStateChanged;
        ChatToolbar.Changed += OnChatToolbarChanged;
        RefreshAnsweringState();

        var settings = await UserSettingsService.GetSettingsAsync();
        pickerModel = settings.DefaultModel;

        _theme = AppTheme.Create(_lightPalette, _darkPalette);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        RefreshAnsweringState();
    }

    private void OnAnsweringStateChanged(bool answering)
    {
        RefreshAnsweringState();
        InvokeAsync(StateHasChanged);
    }

    private void OnChatToolbarChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSessionStateAsync()
    {
        await ChatToolbar.ToggleSessionStateAsync();
    }
    private async Task ToggleTraceAsync() => await ChatToolbar.ToggleTraceAsync();

    private bool IsOnChatPage()
    {
        var currentPath = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).LocalPath;
        return currentPath == "/" ||
               currentPath == "/chat" ||
               currentPath == "/chat-agentic";
    }

    private bool IsOnAgenticChatPage()
    {
        var currentPath = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).LocalPath;
        return string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(currentPath, "/chat", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(currentPath, "/chat-agentic", StringComparison.OrdinalIgnoreCase);
    }

    private bool ActiveChatHasAgents() => AgenticChatService.Agents.Any();

    private async Task NewChat()
    {
        if (AgenticChatService.IsAnswering)
        {
            await AgenticChatService.CancelAsync();
        }

        await AgenticChatService.ResetAsync();
        if (!IsOnChatPage())
        {
            NavigationManager.NavigateTo("/chat");
        }
    }

    private async Task OnModelChanged(ServerModelSelection model)
    {
        pickerModel = model;

        var settings = await UserSettingsService.GetSettingsAsync();
        settings.DefaultModel = model;
        await UserSettingsService.SaveSettingsAsync(settings);
        StateHasChanged();
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };

    public ValueTask DisposeAsync()
    {
        AgenticChatService.AnsweringStateChanged -= OnAnsweringStateChanged;
        ChatToolbar.Changed -= OnChatToolbarChanged;
        return ValueTask.CompletedTask;
    }

    private void RefreshAnsweringState()
    {
        isLLMAnswering = IsOnAgenticChatPage() && AgenticChatService.IsAnswering;
    }
}
