@page "/scheduled-tasks"
@using ChatClient.Domain.Models
@using ChatClient.Application.Services
@using ChatClient.Api.Services.Scheduling
@using ChatClient.Application.Services.AgentRuntime
@implements IAsyncDisposable
@inject IScheduledTaskService Tasks
@inject IScheduledTaskManualRunService ManualRuns
@inject IAgentDefinitionCatalog AgentCatalog
@inject ISnackbar Snackbar
@inject ITimerEventPublisher TimerEvents
@inject ILogger<ScheduledTasks> TimerLogger

<AppPage Title="Scheduled Tasks">
    <AppCrudToolbar AddText="Add Timer" OnAdd="AddTimer" AddDisabled="@(!string.IsNullOrEmpty(storageError))"
                    SearchText="@searchText" SearchTextChanged="OnSearch" SearchPlaceholder="Search timers...">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       OnClick="LoadAsync">Reload</MudButton>
        </Actions>
    </AppCrudToolbar>

    @if (!string.IsNullOrWhiteSpace(storageError))
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            Scheduled task storage is unavailable. Changes are blocked until the JSON file is repaired.
            @storageError
        </MudAlert>
    }
    @if (pendingCleanup.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @pendingCleanup.Count deleted timer(s) still need Quartz cleanup.
            <MudButton Size="Size.Small" Color="Color.Warning" OnClick="RetryCleanupAsync">Retry synchronization</MudButton>
        </MudAlert>
    }

    @if (ManualRuns.Current is { } global && !timers.Any(x => x.Definition.Id == global.ScheduledTaskId))
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            Manual execution is busy with timer @global.TimerName.
        </MudAlert>
    }
    @if (loading)
    {
        <MudStack Justify="Justify.Center" Class="my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudStack>
    }
    else
    {
        <MudDataGrid T="ScheduledTaskView" Items="@filtered" ReadOnly="true" Bordered="true" Hover="true"
                     Striped="true" Dense="true" FixedHeader="true">
            <Columns>
                <TemplateColumn Title="Name" SortBy="x => x.Definition.Name">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.Definition.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Item.Definition.Description))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Item.Definition.Description</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Schedule">
                    <CellTemplate><MudText Typo="Typo.body2">@Summary(context.Item.Definition.Schedule)</MudText></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Agent">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@AgentLabel(context.Item.Definition.AgentExecution?.AgentId)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Time Zone">
                    <CellTemplate><MudText Typo="Typo.body2">@context.Item.Definition.TimeZoneId</MudText></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" SortBy="x => x.Status">
                    <CellTemplate>
                        <MudChip T="string" Variant="Variant.Outlined" Color="@StatusColor(context.Item.Status)" Size="Size.Small">
                            @context.Item.Status
                        </MudChip>
                        @if (context.Item.Error is { } error)
                        {
                            <MudTooltip Text="@error"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Error" /></MudTooltip>
                            <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Manual Run">
                    <CellTemplate>
                        @if (ManualRuns.ForTimer(context.Item.Definition.Id) is { } manual)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@(manual.Status == ManualRunStatus.Failed ? Color.Error : Color.Default)">
                                @manual.Status
                            </MudChip>
                            @if (manual.CancellationRequested is not null && manual.Status == ManualRunStatus.Running)
                            {
                                <MudText Typo="Typo.caption">@manual.CancellationRequested requested</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">—</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Last Fired" SortBy="x => x.LastFiredUtc">
                    <CellTemplate><MudText Typo="Typo.body2">@DisplayTime(context.Item.LastFiredUtc, context.Item.Definition.TimeZoneId)</MudText></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Next Fire" SortBy="x => x.NextFireUtc">
                    <CellTemplate><MudText Typo="Typo.body2">@DisplayTime(context.Item.NextFireUtc, context.Item.Definition.TimeZoneId)</MudText></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Enabled">
                    <CellTemplate>
                        <MudSwitch T="bool" Value="@context.Item.Definition.Enabled"
                                   ValueChanged="@(async (bool enabled) => await ChangeEnabledAsync(context.Item, enabled))"
                                   Disabled="@(busy || storageError is not null)"
                                   Color="Color.Primary" Size="Size.Small"
                                   aria-label="@($"Enable {context.Item.Definition.Name}")" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <div class="app-table-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       Disabled="@(busy || storageError is not null || ManualRuns.Current is not null || !CanRun(context.Item.Definition))"
                                       OnClick="@(() => RunNowAsync(context.Item))">Run Now</MudButton>
                            @if (ManualRuns.ForTimer(context.Item.Definition.Id) is not null)
                            {
                                <MudButton Size="Size.Small" OnClick="@(() => OpenRun(context.Item.Definition.Id))">Result</MudButton>
                            }
                            <MudTooltip Text="Edit timer"><MudIconButton Icon="@Icons.Material.Filled.Edit"
                                Size="Size.Small" aria-label="Edit timer"
                                OnClick="@(() => EditTimerAsync(context.Item))" /></MudTooltip>
                            <MudTooltip Text="Delete timer"><MudIconButton Icon="@Icons.Material.Filled.Delete"
                                Size="Size.Small" Color="Color.Error" aria-label="Delete timer"
                                OnClick="@(() => ConfirmDelete(context.Item))" /></MudTooltip>
                            @if (context.Item.Status == ScheduledTaskStatus.Error)
                            {
                                <MudTooltip Text="Retry Quartz synchronization"><MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                    Size="Size.Small" aria-label="Retry synchronization"
                                    OnClick="@(() => RetryAsync(context.Item))" /></MudTooltip>
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="ScheduledTaskView" PageSizeOptions="new[] { 10, 25, 50, 100 }" /></PagerContent>
            <NoRecordsContent><MudText Class="pa-3">No scheduled tasks yet.</MudText></NoRecordsContent>
        </MudDataGrid>
    }
</AppPage>

<MudDialog @bind-Visible="showEditor" Options="editOptions">
    <TitleContent><MudText Typo="Typo.h6">@(creating ? "Create Timer" : "Edit Timer")</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @if (!string.IsNullOrEmpty(editorError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@editorError</MudAlert>
            }
            <MudText Typo="Typo.subtitle2">General</MudText>
            <MudTextField T="string" @bind-Value="editing.Name" Label="Name" Required="true"
                          Margin="Margin.Dense" Immediate="true" />
            <MudTextField T="string" @bind-Value="editing.Description" Label="Description"
                          Margin="Margin.Dense" Lines="2" />
            <MudCheckBox T="bool" @bind-Value="editing.Enabled" Label="Enabled" Dense="true" />

            <MudText Typo="Typo.subtitle2" Class="mt-2">Schedule</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="3">
                    <MudSelect Class="app-bounded-select" T="ScheduleType" @bind-Value="editing.Schedule.Type" @bind-Value:after="RefreshPreviewAsync"
                               Label="Type" Margin="Margin.Dense" Dense="true">
                        @foreach (var type in Enum.GetValues<ScheduleType>())
                        {
                            <MudSelectItem T="ScheduleType" Value="@type">@(type == ScheduleType.Cron ? "Advanced Cron" : type.ToString())</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (editing.Schedule.Type == ScheduleType.Interval)
                {
                    <MudItem xs="6" sm="2">
                        <MudNumericField Class="app-numeric-field app-numeric-field--short" T="int" @bind-Value="editing.Schedule.IntervalValue" @bind-Value:after="RefreshPreviewAsync"
                                         Label="Every" Min="1" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudSelect Class="app-bounded-select app-bounded-select--short" T="ScheduleIntervalUnit" @bind-Value="editing.Schedule.IntervalUnit" @bind-Value:after="RefreshPreviewAsync"
                                   Label="Unit" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem T="ScheduleIntervalUnit" Value="ScheduleIntervalUnit.Minutes">Minutes</MudSelectItem>
                            <MudSelectItem T="ScheduleIntervalUnit" Value="ScheduleIntervalUnit.Hours">Hours</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }
                else if (editing.Schedule.Type != ScheduleType.Cron)
                {
                    <MudItem xs="6" sm="2">
                        <MudNumericField Class="app-numeric-field app-numeric-field--short" T="int" @bind-Value="editing.Schedule.Hour" @bind-Value:after="RefreshPreviewAsync"
                                         Label="Hour" Min="0" Max="23" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField Class="app-numeric-field app-numeric-field--short" T="int" @bind-Value="editing.Schedule.Minute" @bind-Value:after="RefreshPreviewAsync"
                                         Label="Minute" Min="0" Max="59" Margin="Margin.Dense" />
                    </MudItem>
                }
                @if (editing.Schedule.Type == ScheduleType.Cron)
                {
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="editing.Schedule.CronExpression" @bind-Value:after="RefreshPreviewAsync"
                            Label="Quartz Cron Expression" Margin="Margin.Dense"
                            HelperText="6 or 7 fields, seconds must be 0. Example: 0 0 14 ? * MON-FRI. Quartz day rules differ from Unix Cron." />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudAutocomplete T="string" Value="@editing.TimeZoneId" ValueChanged="OnTimeZoneChanged"
                                     SearchFunc="SearchZones" ToStringFunc="ZoneLabel"
                                     Label="Time Zone" Margin="Margin.Dense" Dense="true" Clearable="false"
                                     ResetValueOnEmptyText="false" MaxItems="40">
                        <ItemTemplate Context="zoneId"><MudText Typo="Typo.body2">@ZoneLabel(zoneId)</MudText></ItemTemplate>
                    </MudAutocomplete>
                </MudItem>
            </MudGrid>
            @if (editing.Schedule.Type == ScheduleType.Weekly)
            {
                <MudText Typo="Typo.caption">Days of week</MudText>
                <MudGrid Spacing="1">
                    @foreach (var day in WeekDays)
                    {
                        <MudItem xs="6" sm="3">
                            <MudCheckBox T="bool" Value="@editing.Schedule.DaysOfWeek.Contains(day)"
                                         ValueChanged="@(async (bool value) => await SetWeekday(day, value))"
                                         Label="@day.ToString()" Dense="true" />
                        </MudItem>
                    }
                </MudGrid>
            }
            @if (editing.Schedule.Type == ScheduleType.Monthly)
            {
                <MudText Typo="Typo.caption">Days of month (missing dates are skipped)</MudText>
                <MudGrid Spacing="0">
                    @for (var day = 1; day <= 31; day++)
                    {
                        var selectedDay = day;
                        <MudItem xs="3" sm="2" md="1">
                            <MudCheckBox T="bool" Value="@editing.Schedule.DaysOfMonth.Contains(selectedDay)"
                                         ValueChanged="@(async (bool value) => await SetMonthDay(selectedDay, value))"
                                         Label="@selectedDay.ToString()" Dense="true" />
                        </MudItem>
                    }
                </MudGrid>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-2">Agent Execution</MudText>
            <MudAutocomplete T="Guid?" Value="@selectedAgentId" ValueChanged="OnAgentChanged"
                             SearchFunc="SearchAgents" ToStringFunc="AgentLabel"
                             Label="Saved Agent" Margin="Margin.Dense" Clearable="true"
                             ResetValueOnEmptyText="false" MaxItems="40" />
            @if (selectedAgentId is { } selected && !agents.Any(x => x.Reference.Id == selected.ToString("D")))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The selected Saved Agent is missing or unavailable. The binding will be preserved until you change it.
                </MudAlert>
            }
            @if (selectedAgentId is not null)
            {
                <MudTextField T="string" @bind-Value="agentPrompt" Label="Prompt"
                              Margin="Margin.Dense" Lines="4"
                              HelperText="@($"Maximum {ScheduledAgentConfigurationValidation.MaximumPromptLength} characters.")" />
            }
            <MudText Typo="Typo.subtitle2" Class="mt-2">Next Occurrences</MudText>
            @if (previewBusy)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (previewError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@previewError</MudAlert>
            }
            else if (preview.Count == 0)
            {
                <MudText Typo="Typo.body2">No future occurrences.</MudText>
            }
            else
            {
                @foreach (var occurrence in preview)
                {
                    <MudText Typo="Typo.body2">@DisplayTime(occurrence, editing.TimeZoneId)</MudText>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="CancelEdit">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   Disabled="@(busy || previewBusy || previewError is not null)"
                   OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="showRunDialog" Options="editOptions">
    <TitleContent><MudText Typo="Typo.h6">Manual Agent Execution</MudText></TitleContent>
    <DialogContent>
        @if (activeRunId is { } runId && ManualRuns.Find(runId) is { } run)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">@run.TimerName — @run.AgentName</MudText>
                <MudText Typo="Typo.body2">Status: @run.Status</MudText>
                <MudText Typo="Typo.body2">Started: @run.StartedUtc.ToLocalTime().ToString("G")</MudText>
                <MudText Typo="Typo.body2">Elapsed: @((run.FinishedUtc ?? DateTimeOffset.UtcNow) - run.StartedUtc)</MudText>
                @if (run.Status == ManualRunStatus.Running)
                {
                    <MudProgressLinear Indeterminate="true" />
                    @if (run.CancellationRequested is not null)
                    {
                        <MudText Typo="Typo.body2">@run.CancellationRequested requested; finishing cleanup...</MudText>
                    }
                    <MudButton Color="Color.Warning" Disabled="@(run.CancellationRequested is not null)"
                               OnClick="@(() => ManualRuns.Cancel(run.ManualRunId))">Cancel</MudButton>
                }
                @if (run.FinalText is not null)
                {
                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap;overflow-wrap:anywhere">@run.FinalText</MudText>
                    @if (run.IsTruncated)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">Output was truncated.</MudAlert>
                    }
                }
                @if (run.ErrorCode is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@run.ErrorCode: @run.ErrorMessage</MudAlert>
                }
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2">This run is no longer in memory.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => showRunDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<AppDeleteDialog @bind-Visible="showDelete" Title="Delete Timer"
                 Message="@($"Delete timer \"{deleting?.Definition.Name}\"?")"
                 OnConfirm="DeleteAsync" Options="deleteOptions" />

@code {
    private List<AgentDefinitionDescriptor> agents = [];
    private Guid? selectedAgentId;
    private string agentPrompt = "";
    private Guid? activeRunId;
    private bool showRunDialog;

    private static bool CanRun(ScheduledTaskDefinition definition)
    {
        try { ScheduledAgentConfigurationValidation.Validate(definition.AgentExecution); return true; }
        catch (ArgumentException) { return false; }
    }

    private string AgentLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty) return "—";
        return agents.FirstOrDefault(a => a.Reference.Id == id.Value.ToString("D"))?.Name
            ?? $"Missing Agent ({id:D})";
    }

    private Task<IEnumerable<Guid?>> SearchAgents(string search, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        IEnumerable<Guid?> matching = agents
            .Where(a => string.IsNullOrWhiteSpace(search) ||
                a.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(40)
            .Select(a => (Guid?)Guid.Parse(a.Reference.Id));
        return Task.FromResult(matching);
    }

    private Task OnAgentChanged(Guid? value)
    {
        selectedAgentId = value;
        if (value is null) agentPrompt = "";
        return Task.CompletedTask;
    }

    private async Task LoadAgentsAsync()
    {
        try
        {
            agents = (await AgentCatalog.GetAllAsync())
                .Where(a => a.Reference.Kind == AgentDefinitionKind.SavedAgent)
                .ToList();
        }
        catch (Exception ex)
        {
            TimerLogger.LogWarning(ex, "Saved Agent catalog unavailable for timer editor");
            agents = [];
        }
    }

    private async Task RunNowAsync(ScheduledTaskView timer)
    {
        var started = await ManualRuns.RunNowAsync(timer.Definition.Id);
        if (!started.Accepted)
        {
            Snackbar.Add(started.Message ?? "Could not start the agent.", Severity.Warning);
            return;
        }
        activeRunId = started.Run!.ManualRunId;
        showRunDialog = true;
    }

    private void OpenRun(Guid taskId)
    {
        activeRunId = ManualRuns.ForTimer(taskId)?.ManualRunId;
        showRunDialog = activeRunId is not null;
    }

    private void OnManualStateChanged()
    {
        if (!_disposed) _ = RefreshManualStateSafeAsync();
    }

    private async Task RefreshManualStateSafeAsync()
    {
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
        catch (Exception ex) { TimerLogger.LogDebug(ex, "Could not refresh manual run state"); }
    }

    private readonly DialogOptions editOptions = new() { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions deleteOptions = new() { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
    private static readonly DayOfWeek[] WeekDays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];
    private static readonly IReadOnlyList<TimeZoneInfo> Zones = TimeZoneInfo.GetSystemTimeZones().ToList();
    // Windows exposes Windows zone IDs, whereas portable saved settings should offer IANA IDs.
    private static readonly IReadOnlyList<string> ZoneIds = Zones.Select(zone => zone.Id)
        .Concat(Zones.Select(zone => TimeZoneInfo.TryConvertWindowsIdToIanaId(zone.Id, out var iana) ? iana : null)
            .OfType<string>())
        .Concat(["Europe/Madrid", "Europe/Budapest", "UTC"])
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
    private Task? _loadTask;
    private bool _refreshRequested;
    private volatile bool _disposed;
    private List<ScheduledTaskView> timers = [];
    private List<ScheduledTaskView> filtered = [];
    private IReadOnlyList<Guid> pendingCleanup = [];
    private List<DateTimeOffset> preview = [];
    private ScheduledTaskDefinition editing = new();
    private ScheduledTaskView? deleting;
    private string searchText = "";
    private string? storageError;
    private string? editorError;
    private string? previewError;
    private bool loading = true;
    private bool busy;
    private bool creating;
    private bool showEditor;
    private bool showDelete;
    private bool previewBusy;
    private int previewSequence;

    protected override async Task OnInitializedAsync()
    {
        await LoadAgentsAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        TimerEvents.TimerFired += OnTimerFired;
        ManualRuns.StateChanged += OnManualStateChanged;
        // Close the window between prerender/initial read and interactive subscription.
        await LoadAsync();
    }

    private void OnTimerFired(TimerFiredEvent notification)
    {
        if (_disposed) return;
        _ = RefreshOnEventSafeAsync();
    }

    private async Task RefreshOnEventSafeAsync()
    {
        try
        {
            await InvokeAsync(LoadAsync);
        }
        catch (Exception ex)
        {
            TimerLogger.LogDebug(ex, "Could not refresh scheduled tasks after firing");
        }
    }

    // All requests arrive on the component dispatcher; coalesce overlapping reads
    // and repeat whenever an event arrives during an outstanding query.
    private Task LoadAsync()
    {
        if (_disposed) return Task.CompletedTask;
        _refreshRequested = true;
        if (_loadTask is { IsCompleted: false }) return _loadTask;
        _loadTask = LoadUntilCurrentAsync();
        return _loadTask;
    }

    private async Task LoadUntilCurrentAsync()
    {
        while (_refreshRequested && !_disposed)
        {
            _refreshRequested = false;
            loading = true;
            try
            {
                var updatedTimers = (await Tasks.GetAllAsync()).ToList();
                var updatedCleanup = await Tasks.GetPendingCleanupAsync();
                if (_disposed) return;
                if (_refreshRequested) continue;

                timers = updatedTimers;
                pendingCleanup = updatedCleanup;
                storageError = null;
                ApplySearch();
            }
            catch (Exception ex)
            {
                if (!_disposed && !_refreshRequested)
                    storageError = ex.Message;
            }
            finally
            {
                if (!_disposed)
                {
                    loading = false;
                    StateHasChanged();
                }
            }
        }
    }

    private void OnSearch(string? query) { searchText = query ?? ""; ApplySearch(); }
    private void ApplySearch() => filtered = timers.Where(x => (x.Definition.Name ?? string.Empty).Contains(
        searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    private void AddTimer()
    {
        editing = new ScheduledTaskDefinition
        {
            Id = Guid.NewGuid(),
            Name = "",
            TimeZoneId = TimeZoneInfo.Local.Id,
            Schedule = new ScheduleDefinition { Type = ScheduleType.Weekly, DaysOfWeek = [DayOfWeek.Monday,
                DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday] }
        };
        selectedAgentId = null;
        agentPrompt = "";
        creating = true;
        editorError = null;
        showEditor = true;
        _ = RefreshPreviewAsync();
    }

    private async Task EditTimerAsync(ScheduledTaskView timer)
    {
        editing = JsonSerializer.Deserialize<ScheduledTaskDefinition>(
            JsonSerializer.Serialize(timer.Definition))!;
        editing.Schedule ??= new ScheduleDefinition();
        await LoadAgentsAsync();
        selectedAgentId = editing.AgentExecution?.AgentId;
        agentPrompt = editing.AgentExecution?.Prompt ?? "";
        creating = false;
        editorError = null;
        showEditor = true;
        await RefreshPreviewAsync();
    }

    private async Task OnTimeZoneChanged(string zone)
    {
        editing.TimeZoneId = zone ?? "";
        await RefreshPreviewAsync();
    }

    private Task<IEnumerable<string>> SearchZones(string search, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        IEnumerable<string> result = ZoneIds.Where(id =>
                string.IsNullOrWhiteSpace(search) ||
                id.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                ZoneLabel(id).Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(40);
        return Task.FromResult(result);
    }

    private static string ZoneLabel(string? id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(id);
            return $"{id} — {zone.DisplayName}";
        }
        catch { return id; }
    }

    private async Task SetWeekday(DayOfWeek day, bool enabled)
    {
        if (enabled && !editing.Schedule.DaysOfWeek.Contains(day)) editing.Schedule.DaysOfWeek.Add(day);
        if (!enabled) editing.Schedule.DaysOfWeek.Remove(day);
        editing.Schedule.DaysOfWeek.Sort();
        await RefreshPreviewAsync();
    }

    private async Task SetMonthDay(int day, bool enabled)
    {
        if (enabled && !editing.Schedule.DaysOfMonth.Contains(day)) editing.Schedule.DaysOfMonth.Add(day);
        if (!enabled) editing.Schedule.DaysOfMonth.Remove(day);
        editing.Schedule.DaysOfMonth.Sort();
        await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        var sequence = ++previewSequence;
        previewBusy = true;
        previewError = null;
        try
        {
            var result = await Tasks.PreviewAsync(editing);
            if (!_disposed && sequence == previewSequence)
                preview = result.ToList();
        }
        catch (Exception ex)
        {
            if (!_disposed && sequence == previewSequence)
            {
                preview = [];
                previewError = ex.Message;
            }
        }
        finally
        {
            if (!_disposed && sequence == previewSequence)
                previewBusy = false;
            if (!_disposed)
            {
                try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
                catch (Exception ex) { TimerLogger.LogDebug(ex, "Could not update timer preview"); }
            }
        }
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        try
        {
            busy = true;
            editorError = null;
            editing.AgentExecution = selectedAgentId is { } agentId
                ? new ScheduledAgentConfiguration { AgentId = agentId, Prompt = agentPrompt }
                : null;
            if (editing.AgentExecution is not null)
                ScheduledAgentConfigurationValidation.Validate(editing.AgentExecution);
            if (creating) await Tasks.CreateAsync(editing);
            else await Tasks.UpdateAsync(editing);
            showEditor = false;
            Snackbar.Add("Timer saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            editorError = ex.Message;
            if (ex.Message.StartsWith("Configuration saved", StringComparison.Ordinal))
                showEditor = false;
        }
        finally
        {
            busy = false;
            await LoadAsync();
        }
    }

    private void CancelEdit() { ++previewSequence; showEditor = false; editorError = null; }
    private void ConfirmDelete(ScheduledTaskView timer) { deleting = timer; showDelete = true; }

    private async Task DeleteAsync()
    {
        if (deleting is null || busy) return;
        try
        {
            busy = true;
            await Tasks.DeleteAsync(deleting.Definition.Id, deleting.Definition.Revision);
            showDelete = false;
            Snackbar.Add("Timer deleted.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { busy = false; await LoadAsync(); }
    }

    private async Task ChangeEnabledAsync(ScheduledTaskView timer, bool enabled)
    {
        if (busy) return;
        try
        {
            busy = true;
            await Tasks.SetEnabledAsync(timer.Definition.Id, timer.Definition.Revision, enabled);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { busy = false; await LoadAsync(); }
    }

    private async Task RetryAsync(ScheduledTaskView timer)
    {
        try { await Tasks.RetryAsync(timer.Definition.Id); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { await LoadAsync(); }
    }

    private async Task RetryCleanupAsync()
    {
        try { await Tasks.RetryCleanupAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { await LoadAsync(); }
    }

    private static Color StatusColor(ScheduledTaskStatus status) => status switch
    {
        ScheduledTaskStatus.Active => Color.Primary,
        ScheduledTaskStatus.Completed => Color.Warning,
        ScheduledTaskStatus.Error => Color.Error,
        _ => Color.Default
    };

    private static string Summary(ScheduleDefinition? s) => s is null ? "Invalid schedule" : s.Type switch
    {
        ScheduleType.Interval => $"Every {s.IntervalValue} {s.IntervalUnit.ToString().ToLowerInvariant()}",
        ScheduleType.Daily => $"Every day at {s.Hour:00}:{s.Minute:00}",
        ScheduleType.Weekly => $"{string.Join(", ", s.DaysOfWeek.Select(x => x.ToString()[..3]))} at {s.Hour:00}:{s.Minute:00}",
        ScheduleType.Monthly => $"Days {string.Join(", ", s.DaysOfMonth)} at {s.Hour:00}:{s.Minute:00}",
        ScheduleType.Cron => s.CronExpression,
        _ => "Invalid schedule"
    };

    private static string DisplayTime(DateTimeOffset? utc, string timeZoneId)
    {
        if (utc is null) return "—";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
            return TimeZoneInfo.ConvertTime(utc.Value, zone).ToString("ddd yyyy-MM-dd HH:mm zzz");
        }
        catch { return "Invalid time zone"; }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        TimerEvents.TimerFired -= OnTimerFired;
        ManualRuns.StateChanged -= OnManualStateChanged;
        ++previewSequence;
        return ValueTask.CompletedTask;
    }
}
