@page "/vector-search"
@using ChatClient.Application.Services
@using ChatClient.Domain.Models
@inject IKnowledgeStoreService Stores
@inject IKnowledgeSearchService Search
@inject ISnackbar Snackbar

<PageTitle>Vector Search</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudStack Spacing="2">
        <MudSelect T="Guid?" Label="Knowledge Store" @bind-Value="selectedStoreId" Dense="true">
            @foreach (var store in stores)
            {
                <MudSelectItem Value="@store.Id">@store.Name (@store.Index.State)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="query" Label="Query" Immediate="true" />
        <MudButton OnClick="SearchAsync" Color="Color.Primary" Disabled="@(selectedStoreId is null)">Search</MudButton>
        @foreach (var result in results)
        {
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.subtitle2">@result.KnowledgeStoreName / @result.FileName</MudText>
                @if (!string.IsNullOrWhiteSpace(result.Section)) { <MudText Typo="Typo.caption">@result.Section</MudText> }
                <MudText Typo="Typo.body2">@result.Content</MudText>
                <MudText Typo="Typo.caption">Score: @result.Score.ToString("0.###")</MudText>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private List<KnowledgeStore> stores = [];
    private Guid? selectedStoreId;
    private string query = string.Empty;
    private List<RagSearchResult> results = [];

    protected override async Task OnInitializedAsync() => stores = (await Stores.GetAllAsync()).OrderBy(x => x.Name).ToList();
    private async Task SearchAsync()
    {
        if (selectedStoreId is not Guid id || string.IsNullOrWhiteSpace(query)) return;
        try { results = (await Search.SearchAsync([id], query)).Results.ToList(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
