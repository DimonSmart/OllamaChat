@page "/compaction-profiles"
@using ChatClient.Api.Services
@inject ICompactionProfileService CompactionProfileService
@inject ISnackbar Snackbar

<PageTitle>Compaction Profiles</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3">
    <MudText Class="page-header">Compaction Profiles</MudText>
    <MudPaper Elevation="3" Class="pa-3 rounded-lg">
        <MudToolBar Dense="true">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="Create">Add Profile</MudButton>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="Search" Placeholder="Search profiles..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" Style="min-width: 280px;" />
        </MudToolBar>
        <MudDataGrid T="CompactionProfile" Items="filteredProfiles" Dense="true" Hover="true" Bordered="true" Class="mt-2">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <TemplateColumn Title="Policy"><CellTemplate><MudText Typo="Typo.body2">@CompactionProfilePresentation.FormatPolicy(context.Item)</MudText></CellTemplate></TemplateColumn>
                <TemplateColumn Title="Budget"><CellTemplate><MudText Typo="Typo.body2">@BudgetSummary(context.Item)</MudText></CellTemplate></TemplateColumn>
                <TemplateColumn Title="Actions" CellStyle="display:flex; justify-content:flex-end;"><CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" AriaLabel="Edit compaction profile" OnClick="@(() => Edit(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" AriaLabel="Delete compaction profile" OnClick="@(() => ConfirmDelete(context.Item))" />
                </CellTemplate></TemplateColumn>
            </Columns>
            <NoRecordsContent><MudText Class="pa-4">No compaction profiles found.</MudText></NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

<MudDialog @bind-Visible="editing" Options="editOptions">
    <TitleContent><MudText Typo="Typo.h6">@(isNew ? "Create Compaction Profile" : "Edit Compaction Profile")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="model">
            <MudTextField @bind-Value="model.Name" Label="Name" Required="true" Immediate="true" Margin="Margin.Dense" Validation="@(new Func<string, string>(ValidateName))" />
            <MudSelect T="string" Value="model.Kind" ValueChanged="ChangeProfileKind" Label="Policy" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@CompactionProfileKinds.ContextWindow">Recommended context window</MudSelectItem>
                <MudSelectItem Value="@CompactionProfileKinds.CustomPipeline">Custom pipeline</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="model.BudgetSource" Label="Budget source" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@CompactionBudgetSources.SelectedModel">Use selected model limits</MudSelectItem>
                <MudSelectItem Value="@CompactionBudgetSources.Fixed">Fixed limits</MudSelectItem>
            </MudSelect>
            @if (model.BudgetSource == CompactionBudgetSources.Fixed)
            {
                <MudStack Row="true" Spacing="2"><MudNumericField T="int?" @bind-Value="model.ContextWindowTokens" Label="Context window tokens" Required="true" Margin="Margin.Dense" /><MudNumericField T="int?" @bind-Value="model.MaxOutputTokens" Label="Maximum output tokens" Required="true" Margin="Margin.Dense" /></MudStack>
                @if (!HasValidFixedBudget()) { <MudText Color="Color.Error" Typo="Typo.caption">Context window must be greater than maximum output.</MudText> }
            }
            @if (model.Kind == CompactionProfileKinds.ContextWindow)
            {
                <MudStack Row="true" Spacing="2"><MudNumericField T="double" Value="@(model.ToolResultThreshold * 100)" ValueChanged="@(value => model.ToolResultThreshold = value / 100)" Label="Tool-result threshold (%)" Min="0.01" Max="100" Margin="Margin.Dense" /><MudNumericField T="double" Value="@(model.TruncationThreshold * 100)" ValueChanged="@(value => model.TruncationThreshold = value / 100)" Label="History truncation threshold (%)" Min="0.01" Max="100" Margin="Margin.Dense" /></MudStack>
                @if (!HasValidContextWindowThresholds()) { <MudText Color="Color.Error" Typo="Typo.caption">Thresholds must be above 0% and at most 100%; history truncation cannot occur before tool-result compaction.</MudText> }
            }
            @if (model.Kind == CompactionProfileKinds.CustomPipeline)
            {
                <MudText Typo="Typo.h6" Class="mt-3 mb-1">Pipeline stages</MudText>
                <MudExpansionPanels MultiExpansion="true" Outlined="true">
                @for (var index = 0; index < model.Stages.Count; index++)
                {
                    var stage = model.Stages[index];
                    <MudExpansionPanel Text="@($"Stage {index + 1}: {stage.Kind}")">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.subtitle2">Stage @(index + 1)</MudText><MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="@(index == 0)" AriaLabel="Move stage up" OnClick="@(() => MoveStage(index, -1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="@(index == model.Stages.Count - 1)" AriaLabel="Move stage down" OnClick="@(() => MoveStage(index, 1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" AriaLabel="Delete stage" OnClick="@(() => RemoveStage(stage))" />
                        </MudStack>
                        <MudSelect T="string" Value="stage.Kind" ValueChanged="@(kind => ChangeStageKind(stage, kind))" Label="Stage type" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="@CompactionStageKinds.ToolResult">Compact tool results</MudSelectItem>
                            <MudSelectItem Value="@CompactionStageKinds.Truncation">Truncate history</MudSelectItem>
                            <MudSelectItem Value="@CompactionStageKinds.Summarization">Summarize history</MudSelectItem>
                            <MudSelectItem Value="@CompactionStageKinds.SlidingWindow">Keep sliding window</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Value="stage.Trigger.Kind" ValueChanged="@(kind => ChangeLimitKind(stage, kind))" Label="Limit kind" Dense="true" Margin="Margin.Dense">
                            @foreach (var limitKind in SupportedLimitKinds(stage.Kind)) { <MudSelectItem Value="@limitKind">@LimitKindLabel(limitKind)</MudSelectItem> }
                        </MudSelect>
                        <MudStack Row="true" Spacing="2">
                            @if (stage.Trigger.Kind == CompactionLimitKinds.InputBudgetPercent)
                            {
                                <MudNumericField T="double" Value="@(stage.Trigger.Value * 100)" ValueChanged="@(value => stage.Trigger.Value = value / 100)" Label="Trigger (%)" Min="0.01" Max="100" Margin="Margin.Dense" />
                                <MudNumericField T="double" Value="@(stage.Target.Value * 100)" ValueChanged="@(value => stage.Target.Value = value / 100)" Label="Target (%)" Min="0.01" Max="100" Margin="Margin.Dense" />
                            }
                            else
                            {
                                <MudNumericField T="double" @bind-Value="stage.Trigger.Value" Label="Trigger" Min="@(stage.Trigger.Kind == CompactionLimitKinds.Tokens ? 1 : 0)" Margin="Margin.Dense" />
                                <MudNumericField T="double" @bind-Value="stage.Target.Value" Label="Target" Min="@(stage.Target.Kind == CompactionLimitKinds.Tokens ? 1 : 0)" Margin="Margin.Dense" />
                            }
                            @if (stage.Kind == CompactionStageKinds.SlidingWindow)
                            {
                                <MudNumericField T="int" @bind-Value="stage.MinimumPreservedTurns" Label="Retain recent turns" Min="0" Margin="Margin.Dense" />
                            }
                            else
                            {
                                <MudNumericField T="int" @bind-Value="stage.MinimumPreservedGroups" Label="Retain recent groups" Min="0" Margin="Margin.Dense" />
                            }
                        </MudStack>
                        @if (!HasValidStageLimits(stage)) { <MudText Color="Color.Error" Typo="Typo.caption">Use supported ordered limits; token limits must be positive.</MudText> }
                        @if (!HasValidResolvedFixedStageLimits(stage)) { <MudText Color="Color.Error" Typo="Typo.caption">These percentages resolve to invalid token thresholds for the fixed input budget.</MudText> }
                        @if (stage.Kind == CompactionStageKinds.Summarization)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Generated summaries become trusted runtime context. Use only a trusted model and endpoint.</MudAlert>
                            <MudTextField @bind-Value="stage.SummaryInstructions" Label="Summary instructions" Lines="3" Margin="Margin.Dense" />
                            <MudCheckBox T="bool" Value="@UsesSeparateSummarizer(stage)" ValueChanged="@(useSeparate => ToggleSeparateSummarizer(stage, useSeparate))" Label="Use a separate trusted summarizer" Dense="true" />
                            @if (UsesSeparateSummarizer(stage))
                            {
                                <ServerModelPicker Value="@GetSummarizerSelection(stage)" ValueChanged="@(selection => SetSummarizerSelection(stage, selection))" ShowClearButton="true" UseDefaultsWhenUnset="false" Presentation="ServerModelPickerPresentation.Form" SelectMargin="Margin.Dense" FillAvailableWidth="false" />
                                @if (!editorState.HasValidSummarizerConfiguration(stage)) { <MudText Color="Color.Error" Typo="Typo.caption">Select both a server and model, or disable the separate summarizer.</MudText> }
                            }
                        }
                    </MudExpansionPanel>
                }
                </MudExpansionPanels>
                @if (model.Stages.Count == 0) { <MudText Color="Color.Error" Typo="Typo.caption">A custom pipeline requires at least one stage.</MudText> }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddStage">Add stage</MudButton>
            }
        </MudForm>
    </DialogContent>
    <DialogActions><MudButton Size="Size.Small" OnClick="Close">Cancel</MudButton><MudButton Color="Color.Primary" Size="Size.Small" Disabled="saving" OnClick="Save">Save</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="deleting" Options="deleteOptions"><TitleContent><MudText Typo="Typo.h6">Delete Compaction Profile</MudText></TitleContent><DialogContent><MudText>Delete "@deletingProfile?.Name"?</MudText></DialogContent><DialogActions><MudButton Size="Size.Small" OnClick="CloseDelete">Cancel</MudButton><MudButton Color="Color.Error" Size="Size.Small" OnClick="Delete">Delete</MudButton></DialogActions></MudDialog>

<MudDialog @bind-Visible="confirmingContextWindowSwitch" Options="contextWindowSwitchOptions"><TitleContent><MudText Typo="Typo.h6">Switch to context-window policy?</MudText></TitleContent><DialogContent><MudText>The configured custom pipeline will be removed.</MudText><MudText>This action cannot be undone after saving.</MudText></DialogContent><DialogActions><MudButton Size="Size.Small" OnClick="CancelContextWindowSwitch">Cancel</MudButton><MudButton Color="Color.Error" Size="Size.Small" OnClick="ConfirmContextWindowSwitch">Switch policy</MudButton></DialogActions></MudDialog>

@code {
    private List<CompactionProfile> profiles = [], filteredProfiles = [];
    private readonly CompactionProfileEditorState editorState = new();
    private CompactionProfile model = new();
    private CompactionProfile? deletingProfile;
    private MudForm? form;
    private bool editing, deleting, isNew, saving, confirmingContextWindowSwitch;
    private readonly DialogOptions editOptions = new() { CloseButton = true, CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Large };
    private readonly DialogOptions deleteOptions = new() { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
    private readonly DialogOptions contextWindowSwitchOptions = new() { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { profiles = (await CompactionProfileService.GetAllAsync()).OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList(); filteredProfiles = profiles.ToList(); }
    private void Search(string value) => filteredProfiles = string.IsNullOrWhiteSpace(value) ? profiles.ToList() : profiles.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase) || CompactionProfilePresentation.FormatPolicy(x).Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
    private void Create() { model = new CompactionProfile(); editorState.Initialize(model); isNew = true; editing = true; }
    private void Edit(CompactionProfile value) { model = Copy(value); editorState.Initialize(model); isNew = false; editing = true; }
    private void AddStage() => model.Stages.Add(CompactionStageDefaults.Create(CompactionStageKinds.ToolResult));
    private void RemoveStage(CompactionStage stage) { editorState.RemoveStage(stage); model.Stages.Remove(stage); }
    private void MoveStage(int index, int direction) { var target = index + direction; if (target < 0 || target >= model.Stages.Count) return; (model.Stages[index], model.Stages[target]) = (model.Stages[target], model.Stages[index]); }
    private void ChangeStageKind(CompactionStage stage, string kind) => editorState.ChangeStageKind(stage, kind);
    private void ChangeLimitKind(CompactionStage stage, string kind) { stage.Trigger.Kind = kind; stage.Target.Kind = kind; }
    private bool UsesSeparateSummarizer(CompactionStage stage) => editorState.UsesSeparateSummarizer(stage);
    private static ServerModelSelection GetSummarizerSelection(CompactionStage stage) => new(stage.SummarizerLlmId, stage.SummarizerModelName);
    private void SetSummarizerSelection(CompactionStage stage, ServerModelSelection selection) => editorState.SetSummarizerSelection(stage, selection.ServerId, selection.ModelName);
    private void ToggleSeparateSummarizer(CompactionStage stage, bool useSeparate) => editorState.ToggleSeparateSummarizer(stage, useSeparate);
    private async Task Save() { if (form is null) return; await form.ValidateAsync(); if (!form.IsValid || !IsValid()) return; try { saving = true; if (isNew) await CompactionProfileService.CreateAsync(model); else await CompactionProfileService.UpdateAsync(model); editing = false; await Load(); Snackbar.Add($"Compaction profile {(isNew ? "created" : "updated")}.", Severity.Success); } catch (Exception ex) { Snackbar.Add($"Could not save compaction profile: {ex.Message}", Severity.Error); } finally { saving = false; } }
    private bool IsValid() => (model.BudgetSource != CompactionBudgetSources.Fixed || HasValidFixedBudget()) && (model.Kind != CompactionProfileKinds.ContextWindow || HasValidContextWindowThresholds()) && (model.Kind != CompactionProfileKinds.CustomPipeline || model.Stages.Count > 0 && model.Stages.All(stage => HasValidStageLimits(stage) && HasValidResolvedFixedStageLimits(stage) && editorState.HasValidSummarizerConfiguration(stage)));
    private bool HasValidFixedBudget() => ModelRuntimeLimitValidation.HasValidTokenBudget(model.ContextWindowTokens, model.MaxOutputTokens);
    private bool HasValidContextWindowThresholds() => model.ToolResultThreshold is > 0 and <= 1 && model.TruncationThreshold is > 0 and <= 1 && model.TruncationThreshold >= model.ToolResultThreshold;
    private static bool HasValidStageLimits(CompactionStage stage) => stage.Trigger is not null && stage.Target is not null && stage.Trigger.Kind == stage.Target.Kind && SupportedLimitKinds(stage.Kind).Contains(stage.Trigger.Kind) && double.IsFinite(stage.Trigger.Value) && double.IsFinite(stage.Target.Value) && (stage.Trigger.Kind == CompactionLimitKinds.InputBudgetPercent ? stage.Trigger.Value is > 0 and <= 1 && stage.Target.Value is > 0 and <= 1 : stage.Trigger.Kind == CompactionLimitKinds.Tokens ? stage.Trigger.Value >= 1 && stage.Target.Value >= 1 : stage.Trigger.Value >= 0 && stage.Target.Value >= 0) && stage.Trigger.Value > stage.Target.Value && (stage.Trigger.Kind == CompactionLimitKinds.InputBudgetPercent || stage.Trigger.Value == Math.Truncate(stage.Trigger.Value) && stage.Target.Value == Math.Truncate(stage.Target.Value)) && stage.MinimumPreservedGroups >= 0 && stage.MinimumPreservedTurns >= 0;
    private bool HasValidResolvedFixedStageLimits(CompactionStage stage)
    {
        if (model.BudgetSource != CompactionBudgetSources.Fixed || stage.Trigger.Kind != CompactionLimitKinds.InputBudgetPercent || !HasValidFixedBudget())
            return true;

        var inputBudget = model.ContextWindowTokens!.Value - model.MaxOutputTokens!.Value;
        var trigger = checked((int)Math.Floor(inputBudget * stage.Trigger.Value));
        var target = checked((int)Math.Floor(inputBudget * stage.Target.Value));
        return trigger > 0 && target > 0 && target < trigger;
    }
    private static IReadOnlyList<string> SupportedLimitKinds(string stageKind) => stageKind == CompactionStageKinds.SlidingWindow ? [CompactionLimitKinds.Turns] : [CompactionLimitKinds.InputBudgetPercent, CompactionLimitKinds.Tokens, CompactionLimitKinds.Messages, CompactionLimitKinds.Groups];
    private static string LimitKindLabel(string kind) => kind switch { CompactionLimitKinds.InputBudgetPercent => "Input budget (%)", CompactionLimitKinds.Tokens => "Tokens", CompactionLimitKinds.Messages => "Messages", CompactionLimitKinds.Turns => "Turns", CompactionLimitKinds.Groups => "Groups", _ => kind };
    private void ConfirmDelete(CompactionProfile value) { deletingProfile = value; deleting = true; }
    private Task ChangeProfileKind(string newKind)
    {
        if (newKind == model.Kind)
            return Task.CompletedTask;

        if (newKind == CompactionProfileKinds.ContextWindow && model.Stages.Count > 0)
        {
            confirmingContextWindowSwitch = true;
            return Task.CompletedTask;
        }

        editorState.ChangeProfileKind(model, newKind);
        return Task.CompletedTask;
    }
    private void ConfirmContextWindowSwitch() { editorState.ChangeProfileKind(model, CompactionProfileKinds.ContextWindow); confirmingContextWindowSwitch = false; }
    private void CancelContextWindowSwitch() => confirmingContextWindowSwitch = false;
    private async Task Delete() { if (deletingProfile is null) return; try { await CompactionProfileService.DeleteAsync(deletingProfile.Id); deleting = false; await Load(); Snackbar.Add("Compaction profile deleted.", Severity.Success); } catch (Exception ex) { Snackbar.Add($"Could not delete compaction profile: {ex.Message}", Severity.Error); } }
    private void Close() => editing = false; private void CloseDelete() => deleting = false;
    private static string ValidateName(string value) => string.IsNullOrWhiteSpace(value) ? "Name is required." : string.Empty;
    private static string BudgetSummary(CompactionProfile value) => value.BudgetSource == CompactionBudgetSources.SelectedModel ? "Selected model limits" : $"Fixed: {value.ContextWindowTokens:N0} / {value.MaxOutputTokens:N0}";
    private static CompactionProfile Copy(CompactionProfile value) => new() { Id = value.Id, Name = value.Name, Kind = value.Kind, BudgetSource = value.BudgetSource, ContextWindowTokens = value.ContextWindowTokens, MaxOutputTokens = value.MaxOutputTokens, ToolResultThreshold = value.ToolResultThreshold, TruncationThreshold = value.TruncationThreshold, CreatedAt = value.CreatedAt, UpdatedAt = value.UpdatedAt, Stages = value.Stages.Select(x => new CompactionStage { Id = x.Id, Kind = x.Kind, Trigger = new CompactionLimit { Kind = x.Trigger.Kind, Value = x.Trigger.Value }, Target = new CompactionLimit { Kind = x.Target.Kind, Value = x.Target.Value }, MinimumPreservedGroups = x.MinimumPreservedGroups, MinimumPreservedTurns = x.MinimumPreservedTurns, SummaryInstructions = x.SummaryInstructions, SummarizerLlmId = x.SummarizerLlmId, SummarizerModelName = x.SummarizerModelName }).ToList() };
}
