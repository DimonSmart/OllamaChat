@page "/agent-mode-provider-profiles"
@using ChatClient.Api.Services
@inject IAgentModeProviderProfileService AgentModeProviderProfileService
@inject ISnackbar Snackbar

<AppPage Title="Agent Mode Provider Profiles">
    <AppCrudToolbar AddText="Add Agent Mode Profile" OnAdd="CreateProfile" SearchText="@searchText" SearchTextChanged="OnSearch" SearchPlaceholder="Search profiles..." />

        @if (loading)
        {
            <MudStack Justify="Justify.Center" Class="my-4"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></MudStack>
        }
        else
        {
            <MudDataGrid T="AgentModeProviderProfile" Items="@filteredProfiles" ReadOnly="true" Bordered="true" Hover="true" Striped="true" Dense="true" FixedHeader="true">
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="Name" />
                    <PropertyColumn Property="x => x.DefaultMode" Title="Default Mode" />
                    <TemplateColumn Title="Modes"><CellTemplate><MudTooltip Text="@string.Join(", ", context.Item.Modes.Select(mode => mode.Name))"><MudText Typo="Typo.body2">@string.Join(", ", context.Item.Modes.Select(mode => mode.Name))</MudText></MudTooltip></CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Instructions"><CellTemplate><MudText Typo="Typo.body2" Class="mud-text-truncate">@Preview(context.Item.Instructions, "Default")</MudText></CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Updated"><CellTemplate><MudText Typo="Typo.body2">@context.Item.UpdatedAt.ToLocalTime().ToString("g")</MudText></CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Created"><CellTemplate><MudText Typo="Typo.body2">@context.Item.CreatedAt.ToLocalTime().ToString("g")</MudText></CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Actions"><CellTemplate><div class="app-table-actions"><MudTooltip Text="Edit profile"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit profile" OnClick="@(() => EditProfile(context.Item))" /></MudTooltip><MudTooltip Text="Delete profile"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Delete profile" OnClick="@(() => ConfirmDelete(context.Item))" /></MudTooltip></div></CellTemplate></TemplateColumn>
                </Columns>
                <PagerContent><MudDataGridPager T="AgentModeProviderProfile" PageSizeOptions="new[] { 10, 25, 50, 100 }" /></PagerContent>
                <NoRecordsContent><MudText Class="pa-3">No Agent Mode Provider profiles yet.</MudText></NoRecordsContent>
            </MudDataGrid>
        }
</AppPage>

<MudDialog @bind-Visible="showEditDialog" Options="editDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(isNewProfile ? "Create Agent Mode Provider Profile" : "Edit Agent Mode Provider Profile")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="editForm" Model="editingProfile">
            <MudGrid Spacing="2">
            <MudItem xs="12"><MudTextField @bind-Value="editingProfile.Name" Label="Name" Required="true" Immediate="true" Margin="Margin.Dense" Validation="@(new Func<string, string>(ValidateName))" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="editingProfile.Instructions" Label="Provider Instructions" Lines="8" Margin="Margin.Dense" HelperText="Optional custom instructions for AgentModeProvider. Leave empty to use Microsoft Agent Framework defaults. Custom instructions must contain: {available_modes} {current_mode}" /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudSelect T="string" @bind-Value="editingProfile.DefaultMode" Label="Default Mode" Required="true" Dense="true" Margin="Margin.Dense">
                @foreach (var mode in editingProfile.Modes.Where(mode => !string.IsNullOrWhiteSpace(mode.Name)))
                {
                    <MudSelectItem T="string" Value="@mode.Name">@mode.Name</MudSelectItem>
                }
            </MudSelect></MudItem>
            </MudGrid>
            <MudText Typo="Typo.h6" Class="mt-3 mb-2">Modes</MudText>
            @for (var index = 0; index < editingProfile.Modes.Count; index++)
            {
                var mode = editingProfile.Modes[index];
                <MudPaper Outlined="true" Class="pa-2 mb-2">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4"><MudTextField @bind-Value="mode.Name" Label="Name" Required="true" Immediate="true" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12" sm="8"><MudTextField @bind-Value="mode.Instructions" Label="Instructions" Lines="5" Required="true" Margin="Margin.Dense" /></MudItem>
                    </MudGrid>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-1"><MudButton Color="Color.Error" Disabled="@(editingProfile.Modes.Count == 1)" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteMode(mode))">Delete</MudButton></MudStack>
                </MudPaper>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddMode">Add Mode</MudButton>
        </MudForm>
    </DialogContent>
    <DialogActions><MudButton OnClick="CloseEditDialog" Size="Size.Small">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile" Disabled="saving" Size="Size.Small">Save</MudButton></DialogActions>
</MudDialog>

<AppDeleteDialog @bind-Visible="showDeleteDialog" Title="Delete Agent Mode Provider Profile" Message="@($"Delete \"{profileToDelete?.Name}\"?")" OnConfirm="DeleteProfile" Options="deleteDialogOptions" />

@code {
    private List<AgentModeProviderProfile> profiles = [];
    private List<AgentModeProviderProfile> filteredProfiles = [];
    private AgentModeProviderProfile editingProfile = new();
    private AgentModeProviderProfile? profileToDelete;
    private MudForm? editForm;
    private bool loading = true;
    private bool saving;
    private bool isNewProfile;
    private bool showEditDialog;
    private bool showDeleteDialog;
    private string searchText = string.Empty;
    private readonly DialogOptions editDialogOptions = new() { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions deleteDialogOptions = new() { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

    protected override async Task OnInitializedAsync() => await LoadProfiles();

    private async Task LoadProfiles()
    {
        try { loading = true; profiles = (await AgentModeProviderProfileService.GetAllAsync()).OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase).ToList(); ApplySearch(); }
        catch (Exception ex) { Snackbar.Add($"Error loading Agent Mode Provider profiles: {ex.Message}", Severity.Error); }
        finally { loading = false; }
    }

    private void OnSearch(string text) { searchText = text; ApplySearch(); }
    private void ApplySearch() => filteredProfiles = string.IsNullOrWhiteSpace(searchText) ? profiles.ToList() : profiles.Where(profile => Contains(profile.Name, searchText) || Contains(profile.DefaultMode, searchText) || Contains(profile.Instructions, searchText) || profile.Modes.Any(mode => Contains(mode.Name, searchText) || Contains(mode.Instructions, searchText))).ToList();

    private void CreateProfile() { editingProfile = new AgentModeProviderProfile { Modes = [new AgentModeProfile()] }; isNewProfile = true; showEditDialog = true; }
    private void EditProfile(AgentModeProviderProfile profile)
    {
        editingProfile = new AgentModeProviderProfile { Id = profile.Id, Name = profile.Name, Instructions = profile.Instructions, DefaultMode = profile.DefaultMode, CreatedAt = profile.CreatedAt, UpdatedAt = profile.UpdatedAt, Modes = profile.Modes.Select(mode => new AgentModeProfile { Name = mode.Name, Instructions = mode.Instructions }).ToList() };
        isNewProfile = false; showEditDialog = true;
    }
    private void AddMode() => editingProfile.Modes.Add(new AgentModeProfile());
    private void DeleteMode(AgentModeProfile mode) { if (editingProfile.Modes.Count == 1) return; editingProfile.Modes.Remove(mode); if (editingProfile.DefaultMode == mode.Name) editingProfile.DefaultMode = null; }
    private async Task SaveProfile()
    {
        if (editForm is null) return;
        await editForm.ValidateAsync();
        if (!editForm.IsValid) return;
        try { saving = true; if (isNewProfile) await AgentModeProviderProfileService.CreateAsync(editingProfile); else await AgentModeProviderProfileService.UpdateAsync(editingProfile); showEditDialog = false; await LoadProfiles(); Snackbar.Add($"Agent Mode Provider profile {(isNewProfile ? "created" : "updated")}.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add($"Could not save Agent Mode Provider profile: {ex.Message}", Severity.Error); }
        finally { saving = false; }
    }
    private void ConfirmDelete(AgentModeProviderProfile profile) { profileToDelete = profile; showDeleteDialog = true; }
    private async Task DeleteProfile()
    {
        if (profileToDelete is null) return;
        try { await AgentModeProviderProfileService.DeleteAsync(profileToDelete.Id); showDeleteDialog = false; await LoadProfiles(); Snackbar.Add("Agent Mode Provider profile deleted.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add($"Could not delete Agent Mode Provider profile: {ex.Message}", Severity.Error); }
    }
    private void CloseEditDialog() => showEditDialog = false;
    private static string ValidateName(string value) => string.IsNullOrWhiteSpace(value) ? "Name is required." : string.Empty;
    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private static string Preview(string? value, string emptyText = "") => string.IsNullOrWhiteSpace(value) ? emptyText : value.Length <= 100 ? value : $"{value[..100]}…";
}
