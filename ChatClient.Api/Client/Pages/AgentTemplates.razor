@page "/agent-templates"
@using System
@using System.Linq
@using System.Collections.Generic
@using ChatClient.Domain.Models
@using ChatClient.Application.Services
@using ChatClient.Api.Services
@using ChatClient.Api.Services.Seed
@using ChatClient.Api.Client.Components
@inject IAgentTemplateService AgentService
@inject AgentTemplateSeeder AgentTemplateSeeder
@inject ISnackbar Snackbar
@inject IKnowledgeStoreService KnowledgeStoreService
@inject ILlmServerConfigService LlmServerConfigService
@inject IMcpServerConfigService McpServerConfigService
@inject ITodoProviderProfileService TodoProviderProfileService
@inject IAgentModeProviderProfileService AgentModeProviderProfileService
@inject IFileAccessProviderProfileService FileAccessProviderProfileService
@inject IAgentSkillsProfileService AgentSkillsProfileService
@inject ICompactionProfileService CompactionProfileService
@inject IRagProviderProfileService RagProviderProfileService

<AppPage Title="Agent Templates">
    <AppCrudToolbar AddText="Add Agent Template" OnAdd="AddNewAgent" AddDisabled="restoringBuiltInAgents" SearchTextChanged="OnSearch" SearchPlaceholder="Search agent templates...">
        <Actions>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Restore"
                       OnClick="ConfirmRestoreBuiltInAgents"
                       Disabled="@(loading || restoringBuiltInAgents)"
                       Size="Size.Small">
                Restore Built-ins
            </MudButton>
        </Actions>
    </AppCrudToolbar>

        @if (loading)
        {
            <MudStack Justify="Justify.Center" Class="my-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </MudStack>
        }
        else
        {
            <MudDataGrid T="AgentTemplateDefinition" @ref="dataGrid"
                         Items="@filteredAgents"
                         ReadOnly="true"
                         Bordered="true"
                         Hover="true"
                         Striped="true"
                         Dense="true"
                         FixedHeader="true"
                         Height="100%">
                <Columns>
                    <PropertyColumn Property="x => x.AgentName" Title="Name" SortBy="x => x.AgentName" />
                    <TemplateColumn Title="Summary" isEditable="false">
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(context.Item.Summary))
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-truncate">
                                    @context.Item.Summary
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">No summary</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Short Name" isEditable="false">
                        <CellTemplate>
                            <div>
                                @if (!string.IsNullOrWhiteSpace(context.Item.ShortName))
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                        @context.Item.ShortName
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Default</MudText>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Model" isEditable="false">
                        <CellTemplate>
                            <div>
                                @{ var modelDisplay = GetModelDisplay(context.Item); }
                                @if (!string.IsNullOrWhiteSpace(modelDisplay))
                                {
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                                        @modelDisplay
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Default</MudText>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Knowledge Stores" isEditable="false" Class="app-table-cell--center">
                        <CellTemplate>
                            @context.Item.KnowledgeStoreIds.Count
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Tools" isEditable="false" Class="app-table-cell--center">
                        <CellTemplate>
                            @{
                                var displayText = GetToolingDisplayText(context.Item);
                                var tooltipText = GetToolingTooltip(context.Item);
                                var hasAttachments = HasConfiguredMcpBindings(context.Item);
                            }
                            @if (hasAttachments)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Primary" title="@tooltipText">@displayText</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" title="@tooltipText">@displayText</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.UpdatedAt" Title="Updated" Format="g" />
                    <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="g" />
                    <TemplateColumn Title="Content" isEditable="false">
                        <CellTemplate>
                            <div>
                                <MudText Typo="Typo.body2" Class="mud-text-truncate">
                                    @context.Item.Content?.Substring(0, Math.Min(50, context.Item.Content?.Length ?? 0))@(context.Item.Content?.Length > 50 ? "..." : "")
                                </MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Actions">
                        <CellTemplate>
                            <div class="app-table-actions">
                                <MudTooltip Text="Edit template"><MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               aria-label="Edit template"
                                               OnClick="@(async () => await StartEditingAgent(context.Item))" /></MudTooltip>
                                <MudTooltip Text="Delete template"><MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               aria-label="Delete template"
                                               OnClick="() => ConfirmDeleteAgent(context.Item)" /></MudTooltip>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="AgentTemplateDefinition" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
                </PagerContent>
                <NoRecordsContent><MudText Class="pa-3">No agent templates yet.</MudText></NoRecordsContent>
                <LoadingContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-3"><MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" /><MudText>Loading agent templates...</MudText></MudStack>
                </LoadingContent>
            </MudDataGrid>
        }
</AppPage>

<MudDialog @bind-Visible="@showDeleteDialog" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Confirm Delete</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete the agent template "@agentToDelete?.AgentName"?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelDelete" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="DeleteAgent" Size="Size.Small">Delete</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="@showRestoreBuiltInAgentsDialog" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Restore Built-in Agent Templates</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            Restore the built-in agent templates from the shipped seed file? Custom agent templates will be kept, but edits to built-in templates will be replaced with the default content.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelRestoreBuiltInAgents" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Warning"
                   Disabled="@restoringBuiltInAgents"
                   OnClick="RestoreBuiltInAgentsAsync"
                   Size="Size.Small">
            Restore
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="@showEditAgentDialog" Options="editDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(editingAgent?.Id == Guid.Empty ? "Create New Agent Template" : "Edit Agent Template")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="editAgentForm" Model="@editingAgent">
            <MudExpansionPanels MultiExpansion="true" Dense="true" Outlined="true" Elevation="0">
                <MudExpansionPanel Text="General" Expanded="true" KeepContentAlive="true">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="editingAgent.AgentName" Label="Agent Name" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Immediate="true" Validation="@(new Func<string, string>(ValidateName))" />
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4"><MudTextField @bind-Value="editingAgent.ShortName" Label="Short Name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" HelperText="Overrides the global agent name." HelperTextOnFocus="true" /></MudItem>
                            <MudItem xs="12" md="8"><MudTextField @bind-Value="editingAgent.Summary" Label="Summary" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" HelperText="A short description of this saved agent." HelperTextOnFocus="true" /></MudItem>
                        </MudGrid>
                        <MudTextField @bind-Value="editingAgent.Content" Label="Instructions" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="10" Required="true" Immediate="true" Validation="@(new Func<string, string>(ValidateContent))" />
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Model" Expanded="true" KeepContentAlive="true">
                    <MudStack Spacing="2">
                        <ServerModelPicker @bind-Value="editingServerModel" ShowClearButton="true" UseDefaultsWhenUnset="false" SelectVariant="Variant.Outlined" SelectMargin="Margin.Dense" />
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6"><MudNumericField T="double?" @bind-Value="editingAgent.Temperature" Label="Temperature" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Min="0" Max="2" Step="0.1" /></MudItem>
                            <MudItem xs="12" sm="6"><MudNumericField T="double?" @bind-Value="editingAgent.RepeatPenalty" Label="Repeat Penalty" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Min="0" Max="2" Step="0.1" /></MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Unset values inherit chat defaults.</MudText>
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Harness" KeepContentAlive="true">
                    <MudStack Spacing="2">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6"><MudSelect T="Guid?" @bind-Value="editingAgent.TodoProviderProfileId" Label="Todo provider" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"><MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>@foreach (var profile in todoProviderProfiles) { <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@profile.Name</MudSelectItem> }</MudSelect></MudItem>
                            <MudItem xs="12" md="6"><MudSelect T="Guid?" @bind-Value="editingAgent.AgentModeProviderProfileId" Label="Agent mode provider" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"><MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>@foreach (var profile in agentModeProviderProfiles) { <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@profile.Name</MudSelectItem> }</MudSelect></MudItem>
                            <MudItem xs="12" md="6"><MudCheckBox T="bool" @bind-Value="editingAgent.ContinueUntilTodosComplete" Label="Continue until TODOs are complete" /></MudItem>
                            <MudItem xs="12" md="6"><MudNumericField T="int" @bind-Value="editingAgent.MaxTodoCompletionIterations" Label="Maximum autonomous iterations" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Min="1" Max="100" Disabled="@(!editingAgent.ContinueUntilTodosComplete)" /></MudItem>
                            <MudItem xs="12" md="6"><MudSelect T="Guid?" @bind-Value="editingAgent.FileAccessProviderProfileId" Label="File access provider" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"><MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>@foreach (var profile in fileAccessProviderProfiles) { <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@profile.Name</MudSelectItem> }</MudSelect></MudItem>
                            <MudItem xs="12" md="6"><MudCheckBox @bind-Value="editingAgent.EnableFileMemory" Label="Enable file-based agent memory" /></MudItem>
                            <MudItem xs="12" md="6"><MudSelect T="Guid?" @bind-Value="editingAgent.SkillsProviderProfileId" Label="Skills provider" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"><MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>@foreach (var profile in skillsProfiles) { <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@profile.Name</MudSelectItem> }</MudSelect></MudItem>
                            <MudItem xs="12" md="6"><MudSelect T="Guid?" @bind-Value="editingAgent.CompactionProfileId" Label="Compaction profile" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"><MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>@foreach (var profile in compactionProfiles) { <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@($"{profile.Name} — {CompactionProfilePresentation.FormatPolicy(profile)}")</MudSelectItem> }</MudSelect></MudItem>
                            @if (HasUnavailableCompactionProfile()) { <MudItem xs="12"><MudAlert Severity="Severity.Warning" Dense="true">The selected compaction profile is unavailable. Choose another profile or None before saving.</MudAlert></MudItem> }
                        </MudGrid>
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Tools" KeepContentAlive="true">
                    <MudStack Spacing="2">
                        <MudCheckBox T="bool" @bind-Value="editingAgent.EnableShell" Label="Enable shell in sandbox" />
                        <McpServerBindingsEditor Bindings="@editingAgent.McpServerBindings" BindingsChanged="OnMcpBindingsChanged" />
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Knowledge &amp; Retrieval" KeepContentAlive="true">
                    <MudStack Spacing="2">
                        <MudSelect T="Guid?" @bind-Value="editingAgent.RagProviderProfileId" Label="RAG provider" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" HelperText="Knowledge Stores enable retrieval; the RAG profile controls how retrieval works." HelperTextOnFocus="true">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">Built-in defaults</MudSelectItem>
                            @foreach (var profile in ragProviderProfiles) { <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@profile.Name</MudSelectItem> }
                        </MudSelect>
                        @if (HasUnavailableRagProfile()) { <MudAlert Severity="Severity.Warning" Dense="true">The selected RAG Provider profile is unavailable. Choose another profile or Built-in defaults before saving.</MudAlert> }
                        <MudText Typo="Typo.subtitle2">Knowledge Stores</MudText>
                        <MudStack Spacing="0">
                            @foreach (var store in knowledgeStores) { <MudCheckBox T="bool" Value="@editingAgent.KnowledgeStoreIds.Contains(store.Id)" ValueChanged="@(selected => SetKnowledgeStoreAttachment(store.Id, selected))" Label="@($"{store.Name} ({store.Index.State})")" /> }
                        </MudStack>
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Background Agents" KeepContentAlive="true">
                    <MudStack Spacing="2">
                        <MudAutocomplete T="AgentTemplateDefinition" Value="selectedBackgroundAgent" ValueChanged="SetSelectedBackgroundAgent" SearchFunc="SearchBackgroundAgents" ToStringFunc="@(agent => agent?.AgentName ?? string.Empty)" Placeholder="Search and add agent..." Variant="Variant.Outlined" Dense="true" Clearable="true" ResetValueOnEmptyText="true">
                            <ItemTemplate Context="agent"><MudText Typo="Typo.body2">@agent.AgentName</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(agent.Summary) ? "No summary" : agent.Summary)</MudText></ItemTemplate>
                        </MudAutocomplete>
                        @if (SelectedBackgroundAgents().Any()) { <MudChipSet T="Guid">@foreach (var candidate in SelectedBackgroundAgents()) { <MudChip T="Guid" Value="@candidate.Id" OnClose="@(() => SetBackgroundAgent(candidate.Id, false))">@candidate.AgentName</MudChip> }</MudChipSet> }
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelEdit" Size="Size.Small">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAgent" Size="Size.Small">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AgentTemplateDefinition> agents = new();
    private List<AgentTemplateDefinition> filteredAgents = new();
    private bool loading = true;
    private AgentTemplateDefinition? agentToDelete;
    private AgentTemplateDefinition editingAgent = new();
    private bool showDeleteDialog { get; set; }
    private bool showEditAgentDialog { get; set; }
    private bool showRestoreBuiltInAgentsDialog { get; set; }
    private bool restoringBuiltInAgents;
    private string searchString = string.Empty;
    private MudForm? editAgentForm;
    private MudDataGrid<AgentTemplateDefinition>? dataGrid;
    private List<KnowledgeStore> knowledgeStores = new();
    private ServerModelSelection editingServerModel = new(null, null);
    private List<LlmServerConfig> servers = new();
    private List<IMcpServerDescriptor> mcpServers = new();
    private List<TodoProviderProfile> todoProviderProfiles = new();
    private List<AgentModeProviderProfile> agentModeProviderProfiles = new();
    private List<FileAccessProviderProfile> fileAccessProviderProfiles = new();
    private List<AgentSkillsProfile> skillsProfiles = new();
    private List<CompactionProfile> compactionProfiles = new();
    private List<RagProviderProfile> ragProviderProfiles = new();
    private AgentTemplateDefinition? selectedBackgroundAgent;
    private DialogOptions dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        CloseButton = true,
        MaxWidth = MaxWidth.ExtraSmall
    };

    private DialogOptions editDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        CloseButton = true,
        MaxWidth = MaxWidth.Large,
        FullWidth = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAgents();
        servers = (await LlmServerConfigService.GetAllAsync()).ToList();
        mcpServers = (await McpServerConfigService.GetAllAsync()).ToList();
        todoProviderProfiles = (await TodoProviderProfileService.GetAllAsync())
            .OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        agentModeProviderProfiles = (await AgentModeProviderProfileService.GetAllAsync())
            .OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        fileAccessProviderProfiles = (await FileAccessProviderProfileService.GetAllAsync())
            .OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        skillsProfiles = (await AgentSkillsProfileService.GetAllAsync()).OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase).ToList();
        compactionProfiles = (await CompactionProfileService.GetAllAsync())
            .OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        ragProviderProfiles = (await RagProviderProfileService.GetAllAsync())
            .OrderBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task LoadAgents()
    {
        try
        {
            loading = true;
            StateHasChanged();

            agents = (await AgentService.GetAllAsync()).ToList();
            filteredAgents = agents;

            knowledgeStores = (await KnowledgeStoreService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading agents: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private string GetModelDisplay(AgentTemplateDefinition agent)
    {
        if (string.IsNullOrWhiteSpace(agent.ModelName))
            return string.Empty;
        var server = servers.FirstOrDefault(s => s.Id == (agent.LlmId ?? Guid.Empty));
        return server is null || server.Id == Guid.Empty
            ? agent.ModelName
            : $"{server.Name}/{agent.ModelName}";
    }

    private void AddNewAgent()
    {
        editingAgent = new AgentTemplateDefinition
        {
            Id = Guid.Empty,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            AgentName = "",
            Summary = "",
            Content = "",
            ShortName = null,
            ModelName = null,
            LlmId = null,
            Temperature = null,
            RepeatPenalty = null,
            TodoProviderProfileId = null,
            AgentModeProviderProfileId = null,
            FileAccessProviderProfileId = null,
            SkillsProviderProfileId = null,
            CompactionProfileId = null,
            RagProviderProfileId = null,
            BackgroundAgentIds = [],
            EnableShell = false,
            EnableFileMemory = false,
            ContinueUntilTodosComplete = false,
            MaxTodoCompletionIterations = 10,
            McpServerBindings = []
        };
        editingServerModel = new ServerModelSelection(null, null);
        selectedBackgroundAgent = null;
        showEditAgentDialog = true;
    }

    private void OnSearch(string text)
    {
        searchString = text;
        ApplySearch();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchString))
        {
            filteredAgents = new List<AgentTemplateDefinition>(agents);
            return;
        }

        filteredAgents = agents
            .Where(p => p.AgentName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                       p.Summary.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                       p.Content.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }


    private static string FormatSize(long bytes)
    {
        const long kb = 1024;
        const long mb = kb * 1024;
        if (bytes >= mb) return $"{bytes / (double)mb:0.##} MB";
        if (bytes >= kb) return $"{bytes / (double)kb:0.##} KB";
        return $"{bytes} B";
    }

    private async Task StartEditingAgent(AgentTemplateDefinition agent)
    {
        editingAgent = new AgentTemplateDefinition
        {
            Id = agent.Id,
            AgentName = agent.AgentName,
            Summary = agent.Summary,
            Content = agent.Content,
            ShortName = agent.ShortName,
            ModelName = agent.ModelName,
            LlmId = agent.LlmId,
            Temperature = agent.Temperature,
            RepeatPenalty = agent.RepeatPenalty,
            TodoProviderProfileId = agent.TodoProviderProfileId,
            AgentModeProviderProfileId = agent.AgentModeProviderProfileId,
            FileAccessProviderProfileId = agent.FileAccessProviderProfileId,
            SkillsProviderProfileId = agent.SkillsProviderProfileId,
            CompactionProfileId = agent.CompactionProfileId,
            RagProviderProfileId = agent.RagProviderProfileId,
            BackgroundAgentIds = agent.BackgroundAgentIds.Distinct().ToList(),
            EnableShell = agent.EnableShell,
            EnableFileMemory = agent.EnableFileMemory,
            ContinueUntilTodosComplete = agent.ContinueUntilTodosComplete,
            MaxTodoCompletionIterations = agent.MaxTodoCompletionIterations,
            CreatedAt = agent.CreatedAt,
            UpdatedAt = agent.UpdatedAt,
            KnowledgeStoreIds = agent.KnowledgeStoreIds.Distinct().ToList(),
            McpServerBindings = agent.McpServerBindings
                .Select(static binding => binding.Clone())
                .ToList()
        };

        editingServerModel = new ServerModelSelection(agent.LlmId, agent.ModelName);
        selectedBackgroundAgent = null;
        showEditAgentDialog = true;
    }

    private void ConfirmDeleteAgent(AgentTemplateDefinition agent)
    {
        agentToDelete = agent;
        showDeleteDialog = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        agentToDelete = null;
        showDeleteDialog = false;
    }

    private void SetKnowledgeStoreAttachment(Guid storeId, bool selected)
    {
        if (selected && !editingAgent.KnowledgeStoreIds.Contains(storeId)) editingAgent.KnowledgeStoreIds.Add(storeId);
        if (!selected) editingAgent.KnowledgeStoreIds.Remove(storeId);
    }

    private IEnumerable<AgentTemplateDefinition> BackgroundAgentCandidates() => agents
        .Where(candidate => candidate.Id != Guid.Empty &&
                            candidate.Id != editingAgent.Id &&
                            !editingAgent.BackgroundAgentIds.Contains(candidate.Id))
        .OrderBy(candidate => candidate.AgentName, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<AgentTemplateDefinition> SelectedBackgroundAgents() => agents
        .Where(candidate => editingAgent.BackgroundAgentIds.Contains(candidate.Id))
        .OrderBy(candidate => candidate.AgentName, StringComparer.OrdinalIgnoreCase);

    private Task<IEnumerable<AgentTemplateDefinition>> SearchBackgroundAgents(
        string text,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();

        var candidates = BackgroundAgentCandidates();
        if (!string.IsNullOrWhiteSpace(text))
        {
            candidates = candidates.Where(candidate =>
                candidate.AgentName.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                candidate.Summary.Contains(text, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(candidates);
    }

    private void SetSelectedBackgroundAgent(AgentTemplateDefinition? agent)
    {
        if (agent is not null)
        {
            SetBackgroundAgent(agent.Id, true);
        }

        selectedBackgroundAgent = null;
    }

    private void SetBackgroundAgent(Guid agentId, bool selected)
    {
        if (selected && agentId != Guid.Empty && agentId != editingAgent.Id && !editingAgent.BackgroundAgentIds.Contains(agentId))
            editingAgent.BackgroundAgentIds.Add(agentId);
        if (!selected)
            editingAgent.BackgroundAgentIds.Remove(agentId);
    }

    private void ConfirmRestoreBuiltInAgents()
    {
        showRestoreBuiltInAgentsDialog = true;
    }

    private void CancelRestoreBuiltInAgents()
    {
        showRestoreBuiltInAgentsDialog = false;
    }

    private async Task RestoreBuiltInAgentsAsync()
    {
        try
        {
            restoringBuiltInAgents = true;
            await AgentTemplateSeeder.RestoreSeededAsync();
            await LoadAgents();
            showRestoreBuiltInAgentsDialog = false;
            Snackbar.Add("Built-in agent templates restored from the shipped seed file.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error restoring built-in agent templates: {ex.Message}", Severity.Error);
        }
        finally
        {
            restoringBuiltInAgents = false;
        }
    }

    private async Task DeleteAgent()
    {
        if (agentToDelete is null || agentToDelete.Id == Guid.Empty) return;
        try
        {
            await AgentService.DeleteAsync(agentToDelete.Id);
            Snackbar.Add("Agent deleted successfully", Severity.Success);

            agents.Remove(agentToDelete);
            ApplySearch();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting agent: {ex.Message}", Severity.Error);
        }

        agentToDelete = null;
        showDeleteDialog = false;
    }

    private string ValidateName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "Name is required";

        return string.Empty;
    }

    private string ValidateContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "Content is required";

        return string.Empty;
    }

    private string? ValidateTodoCompletionConfiguration()
    {
        if (!editingAgent.ContinueUntilTodosComplete)
        {
            return null;
        }

        if (editingAgent.TodoProviderProfileId is not Guid todoId ||
            todoProviderProfiles.All(profile => profile.Id != todoId))
        {
            return "Todo provider is required for autonomous TODO execution.";
        }

        if (editingAgent.AgentModeProviderProfileId is not Guid modeId ||
            agentModeProviderProfiles.FirstOrDefault(profile => profile.Id == modeId) is not { } modeProfile)
        {
            return "Agent mode provider is required for autonomous TODO execution.";
        }

        if (!modeProfile.Modes.Any(mode =>
                string.Equals(mode.Name, "execute", StringComparison.Ordinal)))
        {
            return "Selected Agent Mode Provider must contain an \"execute\" mode.";
        }

        return editingAgent.MaxTodoCompletionIterations is < 1 or > 100
            ? "Maximum autonomous iterations must be between 1 and 100."
            : null;
    }

    private bool HasUnavailableCompactionProfile()
    {
        return editingAgent.CompactionProfileId is Guid profileId &&
               compactionProfiles.All(profile => profile.Id != profileId);
    }

    private bool HasUnavailableRagProfile()
    {
        return editingAgent.RagProviderProfileId is Guid profileId &&
               ragProviderProfiles.All(profile => profile.Id != profileId);
    }

    private bool HasConfiguredMcpBindings(AgentTemplateDefinition agent)
    {
        return agent.McpServerBindings.Any(binding => binding.Enabled && binding.HasIdentity);
    }

    private string GetToolingDisplayText(AgentTemplateDefinition agent)
    {
        var activeBindings = agent.McpServerBindings.Count(binding => binding.Enabled && binding.HasIdentity);
        if (activeBindings > 0)
        {
            return activeBindings == 1 ? "1 MCP" : $"{activeBindings} MCP";
        }

        return "\u2212";
    }

    private string GetToolingTooltip(AgentTemplateDefinition agent)
    {
        var activeBindings = agent.McpServerBindings.Where(binding => binding.Enabled && binding.HasIdentity).ToList();
        if (activeBindings.Count == 0)
        {
            return "No MCP attachments configured.";
        }

        var explicitToolCount = activeBindings
            .Where(binding => !binding.SelectAllTools)
            .Sum(binding => binding.SelectedTools.Count);
        var hasSelectAll = activeBindings.Any(binding => binding.SelectAllTools);
        var attachmentSummary = hasSelectAll
            ? "At least one attachment exposes all tools."
            : $"{explicitToolCount} tools explicitly selected across attachments.";

        return $"{activeBindings.Count} MCP attachments configured. {attachmentSummary}";
    }

    private void OnMcpBindingsChanged(List<McpServerSessionBinding> bindings)
    {
        editingAgent.McpServerBindings = bindings;
    }

    private async Task EnsureMcpServersLoadedAsync()
    {
        if (mcpServers.Count == 0)
        {
            mcpServers = (await McpServerConfigService.GetAllAsync()).ToList();
        }
    }

    private async Task<string?> PrepareBindingsForSaveAsync()
    {
        await EnsureMcpServersLoadedAsync();

        var normalizedBindings = new List<McpServerSessionBinding>();
        foreach (var originalBinding in editingAgent.McpServerBindings)
        {
            var binding = originalBinding.Clone();
            if (!binding.HasIdentity)
            {
                if (IsEmptyBinding(binding))
                {
                    continue;
                }

                return "Each MCP attachment must reference a server from the registry.";
            }

            var serverDescriptor = ResolveServerDescriptor(binding);
            if (serverDescriptor is null)
            {
                return $"MCP server '{binding.ServerName ?? binding.ServerId?.ToString() ?? "unknown"}' is not registered.";
            }

            binding.BindingId ??= Guid.NewGuid();
            binding.ServerId = serverDescriptor.Id;
            binding.ServerName = serverDescriptor.Name;
            binding.DisplayName = string.IsNullOrWhiteSpace(binding.DisplayName) ? null : binding.DisplayName.Trim();
            binding.Roots = binding.Roots
                .Select(static root => root?.Trim())
                .Where(static root => !string.IsNullOrWhiteSpace(root))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Cast<string>()
                .ToList();
            binding.SelectedTools = binding.SelectedTools
                .Select(static toolName => toolName?.Trim())
                .Where(static toolName => !string.IsNullOrWhiteSpace(toolName))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Cast<string>()
                .ToList();

            var allowedKeys = serverDescriptor.OverrideDefinitions
                .Select(static definition => definition.Key)
                .Where(static key => !string.IsNullOrWhiteSpace(key))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            binding.Parameters = binding.Parameters
                .Where(pair => allowedKeys.Contains(pair.Key) && !string.IsNullOrWhiteSpace(pair.Value))
                .ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.OrdinalIgnoreCase);

            if (binding.Enabled)
            {
                foreach (var definition in serverDescriptor.OverrideDefinitions.Where(static definition => definition.Required))
                {
                    if (binding.Parameters.TryGetValue(definition.Key, out var value) &&
                        !string.IsNullOrWhiteSpace(value))
                    {
                        continue;
                    }

                    var label = string.IsNullOrWhiteSpace(definition.Label) ? definition.Key : definition.Label;
                    return $"Attachment '{GetBindingDisplayName(binding, serverDescriptor)}' requires override '{label}'.";
                }

                if (!binding.SelectAllTools && binding.SelectedTools.Count == 0)
                {
                    return $"Attachment '{GetBindingDisplayName(binding, serverDescriptor)}' must either expose all tools or select at least one tool.";
                }
            }

            normalizedBindings.Add(binding);
        }

        editingAgent.McpServerBindings = normalizedBindings;
        return null;
    }

    private IMcpServerDescriptor? ResolveServerDescriptor(McpServerSessionBinding binding)
    {
        if (binding.ServerId is Guid serverId && serverId != Guid.Empty)
        {
            return mcpServers.FirstOrDefault(server => server.Id == serverId);
        }

        return mcpServers.FirstOrDefault(binding.Matches);
    }

    private static bool IsEmptyBinding(McpServerSessionBinding binding)
    {
        return !binding.HasIdentity &&
               string.IsNullOrWhiteSpace(binding.DisplayName) &&
               binding.Roots.Count == 0 &&
               binding.Parameters.Count == 0 &&
               binding.SelectedTools.Count == 0;
    }

    private static string GetBindingDisplayName(McpServerSessionBinding binding, IMcpServerDescriptor serverDescriptor)
    {
        return McpBindingPresentation.GetServerDisplayName(serverDescriptor, binding);
    }

    private void CancelEdit()
    {
        showEditAgentDialog = false;
    }
    private async Task SaveAgent()
    {
        if (editAgentForm == null) return;
        await editAgentForm.ValidateAsync();
        if (editAgentForm.IsValid)
        {
            try
            {
                editingAgent.LlmId = editingServerModel.ServerId;
                editingAgent.ModelName = editingServerModel.ModelName;
                var todoCompletionError = ValidateTodoCompletionConfiguration();
                if (!string.IsNullOrWhiteSpace(todoCompletionError))
                {
                    Snackbar.Add(todoCompletionError, Severity.Error);
                    return;
                }

                var validationError = await PrepareBindingsForSaveAsync();
                if (!string.IsNullOrWhiteSpace(validationError))
                {
                    Snackbar.Add(validationError, Severity.Error);
                    return;
                }

                if (editingAgent.Id == Guid.Empty)
                {
                    await AgentService.CreateAsync(editingAgent);
                    agents.Add(editingAgent);
                    Snackbar.Add("Agent description created successfully", Severity.Success);
                }
                else
                {
                    editingAgent.UpdatedAt = DateTime.UtcNow;
                    await AgentService.UpdateAsync(editingAgent);
                    var index = agents.FindIndex(p => p.Id == editingAgent.Id);
                    if (index >= 0) agents[index] = editingAgent;
                    Snackbar.Add("Agent description updated successfully", Severity.Success);
                }

                showEditAgentDialog = false;
                ApplySearch();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error saving agent: {ex.Message}", Severity.Error);
            }
        }
    }

