@page "/agent-skills-profiles"
@using ChatClient.Application.Services
@using ChatClient.Domain.Models
@inject IAgentSkillsProfileService Service
@inject ISnackbar Snackbar
<AppPage Title="Skills Provider Profiles">
    <AppCrudToolbar AddText="Add Skills Profile" OnAdd="Create" />
    <MudDataGrid T="AgentSkillsProfile" Items="profiles" Dense="true" Hover="true" Bordered="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <TemplateColumn Title="Claude"><CellTemplate>@(context.Item.IncludeClaudeSkills ? "Included" : "No")</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Sources"><CellTemplate>@context.Item.FileSources.Count</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Actions"><CellTemplate><div class="app-table-actions"><MudTooltip Text="Edit skills profile"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit skills profile" OnClick="@(() => Edit(context.Item))" /></MudTooltip><MudTooltip Text="Delete skills profile"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Delete skills profile" OnClick="@(() => Delete(context.Item.Id))" /></MudTooltip></div></CellTemplate></TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-3">No skills provider profiles yet.</MudText></NoRecordsContent>
    </MudDataGrid>
</AppPage>
<MudDialog @bind-Visible="editing" Options="new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium }">
    <TitleContent><MudText Typo="Typo.h6">Skills Provider Profile</MudText></TitleContent>
    <DialogContent><MudStack Spacing="2"><MudTextField @bind-Value="model.Name" Label="Name" Required="true" Margin="Margin.Dense" /><MudCheckBox @bind-Value="model.IncludeClaudeSkills" Label="Include Claude skills from .claude/skills" />@for (var i=0;i<model.FileSources.Count;i++) { var index=i; <MudPaper Outlined="true" Class="pa-2"><MudStack Spacing="1"><MudTextField @bind-Value="model.FileSources[index].Directory" Label="Directory" Margin="Margin.Dense" /><MudTextField @bind-Value="patterns[index]" Label="Patterns (one per line)" Lines="3" Margin="Margin.Dense" /><MudButton Color="Color.Error" Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Remove(index))">Remove</MudButton></MudStack></MudPaper> } <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSource">Add file source</MudButton></MudStack></DialogContent>
    <DialogActions><MudButton Size="Size.Small" OnClick="() => editing=false">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Save">Save</MudButton></DialogActions>
</MudDialog>
@code { List<AgentSkillsProfile> profiles=[]; AgentSkillsProfile model=new(); List<string> patterns=[]; bool editing; protected override async Task OnInitializedAsync()=>await Load(); async Task Load()=>profiles=(await Service.GetAllAsync()).OrderBy(x=>x.Name).ToList(); void Create(){model=new();patterns=[];editing=true;} void Edit(AgentSkillsProfile value){model=new(){Id=value.Id,Name=value.Name,IncludeClaudeSkills=value.IncludeClaudeSkills,CreatedAt=value.CreatedAt,UpdatedAt=value.UpdatedAt,FileSources=value.FileSources.Select(x=>new SkillFileSource{Directory=x.Directory,Patterns=x.Patterns.ToList()}).ToList()};patterns=model.FileSources.Select(x=>string.Join(Environment.NewLine,x.Patterns)).ToList();editing=true;} void AddSource(){model.FileSources.Add(new SkillFileSource{Patterns=["**/SKILL.md"]});patterns.Add("**/SKILL.md");} void Remove(int i){model.FileSources.RemoveAt(i);patterns.RemoveAt(i);} async Task Save(){try{for(var i=0;i<model.FileSources.Count;i++)model.FileSources[i].Patterns=patterns[i].Split(new[]{'\r','\n'},StringSplitOptions.RemoveEmptyEntries).ToList();if(model.Id==Guid.Empty)await Service.CreateAsync(model);else await Service.UpdateAsync(model);editing=false;await Load();}catch(Exception ex){Snackbar.Add(ex.Message,Severity.Error);}} async Task Delete(Guid id){try{await Service.DeleteAsync(id);await Load();}catch(Exception ex){Snackbar.Add(ex.Message,Severity.Error);}} }
