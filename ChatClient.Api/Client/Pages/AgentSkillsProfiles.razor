@page "/agent-skills-profiles"
@using ChatClient.Application.Services
@using ChatClient.Domain.Models
@inject IAgentSkillsProfileService Service
@inject ISnackbar Snackbar
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3"><MudText Class="page-header">Skills Provider Profiles</MudText><MudPaper Class="pa-3"><MudButton Color="Color.Primary" OnClick="Create">Add Skills Profile</MudButton><MudDataGrid T="AgentSkillsProfile" Items="profiles" Dense="true"><Columns><PropertyColumn Property="x => x.Name" Title="Name" /><TemplateColumn Title="Claude"><CellTemplate>@(context.Item.IncludeClaudeSkills ? "Included" : "No")</CellTemplate></TemplateColumn><TemplateColumn Title="Sources"><CellTemplate>@context.Item.FileSources.Count</CellTemplate></TemplateColumn><TemplateColumn Title="Actions"><CellTemplate><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Edit(context.Item))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => Delete(context.Item.Id))" /></CellTemplate></TemplateColumn></Columns></MudDataGrid></MudPaper></MudContainer>
<MudDialog @bind-Visible="editing" Options="new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium }"><TitleContent><MudText Typo="Typo.h6">Skills Provider Profile</MudText></TitleContent><DialogContent><MudTextField @bind-Value="model.Name" Label="Name" Required="true" /><MudCheckBox @bind-Value="model.IncludeClaudeSkills" Label="Include Claude skills from .claude/skills" />@for (var i=0;i<model.FileSources.Count;i++) { var index=i; <MudPaper Class="pa-2 mt-2"><MudTextField @bind-Value="model.FileSources[index].Directory" Label="Directory" /><MudTextField @bind-Value="patterns[index]" Label="Patterns (one per line)" Lines="3" /><MudButton Color="Color.Error" Size="Size.Small" OnClick="@(() => Remove(index))">Remove</MudButton></MudPaper> } <MudButton Class="mt-2" OnClick="AddSource">Add file source</MudButton></DialogContent><DialogActions><MudButton OnClick="() => editing=false">Cancel</MudButton><MudButton Color="Color.Primary" OnClick="Save">Save</MudButton></DialogActions></MudDialog>
@code { List<AgentSkillsProfile> profiles=[]; AgentSkillsProfile model=new(); List<string> patterns=[]; bool editing; protected override async Task OnInitializedAsync()=>await Load(); async Task Load()=>profiles=(await Service.GetAllAsync()).OrderBy(x=>x.Name).ToList(); void Create(){model=new();patterns=[];editing=true;} void Edit(AgentSkillsProfile value){model=new(){Id=value.Id,Name=value.Name,IncludeClaudeSkills=value.IncludeClaudeSkills,CreatedAt=value.CreatedAt,UpdatedAt=value.UpdatedAt,FileSources=value.FileSources.Select(x=>new SkillFileSource{Directory=x.Directory,Patterns=x.Patterns.ToList()}).ToList()};patterns=model.FileSources.Select(x=>string.Join(Environment.NewLine,x.Patterns)).ToList();editing=true;} void AddSource(){model.FileSources.Add(new SkillFileSource{Patterns=["**/SKILL.md"]});patterns.Add("**/SKILL.md");} void Remove(int i){model.FileSources.RemoveAt(i);patterns.RemoveAt(i);} async Task Save(){try{for(var i=0;i<model.FileSources.Count;i++)model.FileSources[i].Patterns=patterns[i].Split(new[]{'\r','\n'},StringSplitOptions.RemoveEmptyEntries).ToList();if(model.Id==Guid.Empty)await Service.CreateAsync(model);else await Service.UpdateAsync(model);editing=false;await Load();}catch(Exception ex){Snackbar.Add(ex.Message,Severity.Error);}} async Task Delete(Guid id){try{await Service.DeleteAsync(id);await Load();}catch(Exception ex){Snackbar.Add(ex.Message,Severity.Error);}} }
