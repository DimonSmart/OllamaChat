@page "/rag-provider-profiles"
@using ChatClient.Application.Services
@using ChatClient.Domain.Models
@inject IRagProviderProfileService RagProviderProfileService
@inject ISnackbar Snackbar

<AppPage Title="RAG Provider Profiles">
    <AppCrudToolbar AddText="Add RAG Profile" OnAdd="Create" @bind-SearchText="search" SearchPlaceholder="Search profiles..." />
        @if (loading) { <MudProgressCircular Indeterminate="true" Class="ma-4" /> }
        else { <MudDataGrid T="RagProviderProfile" Items="Filtered" Dense="true" Hover="true" Bordered="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.SearchMode" Title="Search mode" />
                <PropertyColumn Property="x => x.RetrievalStrategy" Title="Strategy" />
                <PropertyColumn Property="x => x.MaxResults" Title="Max results" />
                <TemplateColumn Title="Updated"><CellTemplate>@context.Item.UpdatedAt.ToLocalTime().ToString("g")</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Actions"><CellTemplate><div class="app-table-actions"><MudTooltip Text="Edit profile"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit profile" OnClick="@(() => Edit(context.Item))" /></MudTooltip><MudTooltip Text="Delete profile"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Delete profile" OnClick="@(() => ConfirmDelete(context.Item))" /></MudTooltip></div></CellTemplate></TemplateColumn>
            </Columns><PagerContent><MudDataGridPager T="RagProviderProfile" PageSizeOptions="new[] { 10, 25, 50, 100 }" /></PagerContent><NoRecordsContent><MudText Class="pa-3">No RAG Provider profiles yet.</MudText></NoRecordsContent>
        </MudDataGrid> }
</AppPage>

<MudDialog @bind-Visible="editing" Options="dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(isNew ? "Create RAG Provider Profile" : "Edit RAG Provider Profile")</MudText></TitleContent>
    <DialogContent><MudForm @ref="form"><MudGrid Spacing="2">
        <MudItem xs="12"><MudTextField @bind-Value="model.Name" Label="Name" Required="true" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="6"><MudSelect T="RagSearchMode" @bind-Value="model.SearchMode" Label="Search mode" Margin="Margin.Dense" HelperText="Auto uses tool search when function calling is available."><MudSelectItem Value="RagSearchMode.Auto">Auto</MudSelectItem><MudSelectItem Value="RagSearchMode.OnDemand">On demand</MudSelectItem><MudSelectItem Value="RagSearchMode.BeforeInvoke">Before invoke</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="6"><MudSelect T="RagRetrievalStrategy" @bind-Value="model.RetrievalStrategy" Label="Retrieval strategy" Margin="Margin.Dense" HelperText="Hybrid combines semantic and exact-term matching."><MudSelectItem Value="RagRetrievalStrategy.Hybrid">Hybrid</MudSelectItem><MudSelectItem Value="RagRetrievalStrategy.Vector">Vector</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="model.MaxResults" Label="Max results" Min="1" Max="50" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="model.MaxRetrievedContextTokens" Label="Context token budget" Min="256" Max="32768" Margin="Margin.Dense" HelperText="Limits retrieved excerpts, not the whole model context." /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="model.AdjacentChunkCount" Label="Adjacent chunks" Min="0" Max="3" Margin="Margin.Dense" HelperText="1 means one chunk before and one after each anchor." /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="double?" @bind-Value="model.MinRelevanceScore" Label="Minimum relevance" Min="-1" Max="1" Step="0.01" Margin="Margin.Dense" HelperText="Clear this value to disable threshold filtering." /></MudItem>
        <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="model.RecentMessageMemoryLimit" Label="Recent messages" Min="0" Max="50" Margin="Margin.Dense" Disabled="@(model.SearchMode == RagSearchMode.OnDemand)" HelperText="On-demand search lets the model form the focused query through a tool call." /></MudItem>
        <MudItem xs="12"><MudCheckBox @bind-Value="model.IncludeAssistantMessages" Disabled="@(model.SearchMode == RagSearchMode.OnDemand)" Label="Include assistant messages in retrieval context" /></MudItem>
        <MudItem xs="12"><MudCheckBox @bind-Value="model.RequestCitations" Label="Request citations" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="model.FunctionToolDescription" Label="Function tool description" Lines="3" Margin="Margin.Dense" Disabled="@(model.SearchMode == RagSearchMode.BeforeInvoke)" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="model.AdditionalContextInstructions" Label="Additional context instructions" Lines="4" Margin="Margin.Dense" HelperText="These supplement the built-in untrusted-data protection." /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="model.CitationsPrompt" Label="Citations prompt" Lines="3" Margin="Margin.Dense" Disabled="@(!model.RequestCitations)" /></MudItem>
    </MudGrid></MudForm></DialogContent>
    <DialogActions><MudButton Size="Size.Small" OnClick="Close">Cancel</MudButton><MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Disabled="@saving" OnClick="Save">@(saving ? "Saving..." : "Save")</MudButton></DialogActions>
</MudDialog>
<AppDeleteDialog @bind-Visible="deleting" Title="Delete RAG Provider Profile" Message="@($"Delete \"{profileToDelete?.Name}\"?")" OnConfirm="Delete" />

@code {
    private List<RagProviderProfile> profiles = []; private RagProviderProfile model = new(); private RagProviderProfile? profileToDelete;
    private bool loading = true, editing, deleting, isNew, saving; private string search = string.Empty; private MudForm? form;
    private readonly DialogOptions dialogOptions = new() { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
    private IEnumerable<RagProviderProfile> Filtered => profiles.Where(x => string.IsNullOrWhiteSpace(search) || x.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { loading = true; try { profiles = (await RagProviderProfileService.GetAllAsync()).OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } finally { loading = false; } }
    private void Create() { model = new(); isNew = true; editing = true; }
    private void Edit(RagProviderProfile value) { model = new() { Id = value.Id, Name = value.Name, SearchMode = value.SearchMode, RetrievalStrategy = value.RetrievalStrategy, MaxResults = value.MaxResults, MinRelevanceScore = value.MinRelevanceScore, MaxRetrievedContextTokens = value.MaxRetrievedContextTokens, AdjacentChunkCount = value.AdjacentChunkCount, RecentMessageMemoryLimit = value.RecentMessageMemoryLimit, IncludeAssistantMessages = value.IncludeAssistantMessages, FunctionToolDescription = value.FunctionToolDescription, AdditionalContextInstructions = value.AdditionalContextInstructions, RequestCitations = value.RequestCitations, CitationsPrompt = value.CitationsPrompt, CreatedAt = value.CreatedAt, UpdatedAt = value.UpdatedAt }; isNew = false; editing = true; }
    private async Task Save() { if (saving) return; await form!.ValidateAsync(); if (!form.IsValid) return; saving = true; try { if (isNew) await RagProviderProfileService.CreateAsync(model); else await RagProviderProfileService.UpdateAsync(model); Snackbar.Add(isNew ? "RAG Provider Profile created." : "RAG Provider Profile updated.", Severity.Success); editing = false; await Load(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } finally { saving = false; } }
    private void ConfirmDelete(RagProviderProfile value) { profileToDelete = value; deleting = true; }
    private async Task Delete() { if (profileToDelete is null) return; try { await RagProviderProfileService.DeleteAsync(profileToDelete.Id); Snackbar.Add("RAG Provider Profile deleted.", Severity.Success); deleting = false; await Load(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } }
    private void Close() => editing = false;
}
