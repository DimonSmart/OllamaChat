@page "/knowledge-stores"
@implements IAsyncDisposable
@using ChatClient.Application.Services
@using ChatClient.Domain.Models
@using Microsoft.AspNetCore.Components.Forms
@inject IKnowledgeStoreService Stores
@inject IKnowledgeIndexProgressTracker IndexProgress
@inject ISnackbar Snackbar

<PageTitle>Knowledge Stores</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-3">
    <MudStack Row="true" AlignItems="AlignItems.Center"><MudText Class="page-header">Knowledge Stores</MudText><MudSpacer /><MudButton Color="Color.Primary" OnClick="CreateAsync">Create</MudButton></MudStack>
    <MudGrid Class="mt-3">
        <MudItem xs="12" md="4">
            <MudList T="Guid?" Dense="true" @bind-SelectedValue="selectedStoreId">
                @foreach (var item in stores)
                { <MudListItem T="Guid?" Value="@item.Id" OnClick="@(() => Select(item.Id))">@item.Name <MudChip T="string" Size="Size.Small">@GetStoreIndexStatus(item)</MudChip></MudListItem> }
            </MudList>
        </MudItem>
        <MudItem xs="12" md="8">
            @if (selected is not null)
            {
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="selected.Name" Label="Name" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="selected.Description" Label="Description" Lines="3" Margin="Margin.Dense" />
                    <MudText Typo="Typo.subtitle1">Index configuration</MudText>
                    <ServerModelPicker Value="GetEmbeddingSelection()" ValueChanged="OnEmbeddingSelectionChanged" ShowClearButton="false" UseDefaultsWhenUnset="false" SelectVariant="Variant.Outlined" SelectMargin="Margin.Dense" FillAvailableWidth="false" />
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                        <MudNumericField @bind-Value="selected.Configuration.MaxTokensPerChunk" Label="Max tokens per chunk" Min="1" Margin="Margin.Dense" Style="width: 200px; max-width: 100%;" />
                        <MudNumericField @bind-Value="selected.Configuration.OverlapTokens" Label="Overlap tokens" Min="0" Margin="Margin.Dense" Style="width: 200px; max-width: 100%;" />
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(selected.Index.LastError)) { <MudAlert Severity="Severity.Error">@selected.Index.LastError</MudAlert> }
                    <MudStack Row="true"><MudButton Color="Color.Primary" OnClick="SaveAsync">Save</MudButton><MudButton OnClick="ReindexAsync">Reindex</MudButton><MudButton Color="Color.Error" OnClick="DeleteAsync">Delete store</MudButton></MudStack>
                    <MudDivider />
                    <MudText Typo="Typo.subtitle1">Documents</MudText>
                    <MudText Typo="Typo.body2">Markdown/text files are processed directly. Other supported document formats require MarkItDown.</MudText>
                    <InputFile @key="GetUploadInputKey()" OnChange="UploadAsync" multiple disabled="@(activeUpload is not null)" />
                    @if (IsUploadingFor(selected.Id))
                    {
                        <MudText Typo="Typo.body2">Uploading @activeUpload!.CompletedFiles / @activeUpload.TotalFiles</MudText>
                    }
                    <MudTable Items="selected.Documents" Dense="true">
                        <HeaderContent><MudTh>File</MudTh><MudTh>Size</MudTh><MudTh>Updated</MudTh><MudTh>Index status</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate><MudTd><a href="@GetSourceUrl(context.Id)" target="_blank" rel="noopener noreferrer">@context.FileName</a></MudTd><MudTd>@context.Size</MudTd><MudTd>@context.UpdatedUtc.ToLocalTime().ToString("g")</MudTd><MudTd>@if (IndexProgress.Get(selected.Id, context.Id) is { } progress) { <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"><MudText Typo="Typo.body2">Indexing @GetProgressPercentage(progress)%</MudText><MudProgressLinear Value="@GetProgressPercentage(progress)" Style="width: 72px;" /></MudStack> } else { @GetDocumentIndexStatus(context) }</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteDocumentAsync(context.Id))" /></MudTd></RowTemplate>
                    </MudTable>
                </MudStack>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<KnowledgeStore> stores = [];
    private Guid? selectedStoreId;
    private KnowledgeStore? selected;
    private UploadState? activeUpload;
    private int uploadInputVersion;
    private readonly CancellationTokenSource refreshCancellation = new();
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _ = RefreshAsync();
    }
    private async Task ReloadAsync() { stores = (await Stores.GetAllAsync()).OrderBy(x => x.Name).ToList(); selected = selectedStoreId is Guid id ? stores.FirstOrDefault(x => x.Id == id) : null; }
    private void Select(Guid id) { selectedStoreId = id; selected = stores.First(x => x.Id == id); uploadInputVersion++; }
    private async Task CreateAsync() { var created = await Stores.CreateAsync("New Knowledge Store", null); selectedStoreId = created.Id; await ReloadAsync(); }
    private ServerModelSelection GetEmbeddingSelection() => selected is null ? new(null, null) : new(selected.Configuration.ServerId, selected.Configuration.Model);
    private Task OnEmbeddingSelectionChanged(ServerModelSelection selection)
    {
        if (selected is not null)
        {
            selected.Configuration.ServerId = selection.ServerId ?? Guid.Empty;
            selected.Configuration.Model = selection.ModelName ?? string.Empty;
        }
        return Task.CompletedTask;
    }
    private async Task SaveAsync()
    {
        if (selected is null) return;
        if (selected.Configuration.ServerId == Guid.Empty || string.IsNullOrWhiteSpace(selected.Configuration.Model))
        {
            Snackbar.Add("Select an embedding server and model.", Severity.Error);
            return;
        }
        await Stores.UpdateAsync(selected);
        Snackbar.Add("Knowledge Store saved.", Severity.Success);
    }
    private async Task ReindexAsync() { if (selected is null) return; await Stores.RequestReindexAsync(selected.Id); await ReloadAsync(); Snackbar.Add("Reindexing requested.", Severity.Info); }
    private async Task DeleteAsync() { if (selected is null) return; await Stores.DeleteAsync(selected.Id); selectedStoreId = null; selected = null; await ReloadAsync(); }
    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (selected is null) return;
        var targetStoreId = selected.Id;
        var files = args.GetMultipleFiles(100);
        activeUpload = new UploadState(targetStoreId, files.Count);
        try
        {
            foreach (var file in files)
            {
                try { await using var stream = file.OpenReadStream(20 * 1024 * 1024); await Stores.AddOrUpdateDocumentAsync(targetStoreId, file.Name, stream, file.ContentType); }
                catch (Exception ex) { Snackbar.Add($"{file.Name}: {ex.Message}", Severity.Error); }
                finally
                {
                    activeUpload.CompletedFiles++;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        finally
        {
            activeUpload = null;
            uploadInputVersion++;
            await ReloadAsync();
        }
    }
    private async Task DeleteDocumentAsync(Guid id) { if (selected is null) return; await Stores.DeleteDocumentAsync(selected.Id, id); await ReloadAsync(); }
    private string GetStoreIndexStatus(KnowledgeStore store) => store.Index.State switch
    {
        KnowledgeStoreIndexState.Ready => "Indexed",
        KnowledgeStoreIndexState.Indexing => "Indexing",
        KnowledgeStoreIndexState.NotIndexed => "Not indexed",
        KnowledgeStoreIndexState.Outdated => "Outdated",
        KnowledgeStoreIndexState.Failed => "Failed",
        _ => store.Index.State.ToString()
    };
    private string GetDocumentIndexStatus(KnowledgeDocument document)
    {
        if (selected is null)
            return "Unknown";
        return selected.Index.State switch
        {
            KnowledgeStoreIndexState.Ready when document.SourceHash == document.IndexedSourceHash => "Indexed",
            KnowledgeStoreIndexState.Indexing when document.SourceHash == document.IndexedSourceHash => "Indexed",
            KnowledgeStoreIndexState.Indexing => "Pending",
            KnowledgeStoreIndexState.Failed => "Failed",
            KnowledgeStoreIndexState.NotIndexed => "Not indexed",
            KnowledgeStoreIndexState.Outdated => "Outdated",
            _ => "Pending"
        };
    }
    private string GetSourceUrl(Guid documentId) => selected is null ? string.Empty : $"/api/knowledge-stores/{selected.Id}/documents/{documentId}/source";
    private bool IsUploadingFor(Guid storeId) => activeUpload?.StoreId == storeId;
    private (Guid? StoreId, int Version) GetUploadInputKey() => (selected?.Id, uploadInputVersion);
    private static int GetProgressPercentage(KnowledgeDocumentIndexProgress progress) => progress.TotalChunks == 0 ? 0 : progress.ProcessedChunks * 100 / progress.TotalChunks;
    private async Task RefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
            {
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested)
        {
        }
    }
    public ValueTask DisposeAsync()
    {
        refreshCancellation.Cancel();
        refreshCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
    private sealed class UploadState(Guid storeId, int totalFiles)
    {
        public Guid StoreId { get; } = storeId;
        public int TotalFiles { get; } = totalFiles;
        public int CompletedFiles { get; set; }
    }
}
