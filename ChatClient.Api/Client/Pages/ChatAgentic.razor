@page "/"
@page "/chat"
@page "/chat-agentic"
@using System.Linq
@using ChatClient.Api.Client.Components
@using ChatClient.Application.Helpers
@using ChatClient.Application.Services
@using ChatClient.Application.Services.Agentic
@using ChatClient.Application.Services.AgentRuntime
@using ChatClient.Domain.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inherits AgenticChatPageBase

<PageTitle>Agentic Chat with AI Assistant</PageTitle>

<OllamaCheck>
    <MudStack Class="chat-container">
    @if (isLoadingInitialData)
    {
        <MudOverlay Visible="true" DarkBackground="true" Absolute="true">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="mt-2">Loading chat...</MudText>
        </MudOverlay>
    }
    else if (!chatStarted)
    {
        <MudCard Class="ma-auto app-form-card app-form-card--narrow">
            <MudCardContent>
                @if (catalogItems.Count == 0)
                {
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                    <MudText>Loading agents...</MudText>
                }
                else
                {
                    <MudStack Spacing="0" Class="app-compact-form">
                        <MudSelect T="AgentDefinitionDescriptor" Label="Select Agent or Workflow" Value="selectedDefinition" ValueChanged="OnDefinitionChanged" Variant="Variant.Outlined" FullWidth="true" Dense="true" Margin="Margin.Dense" Disabled="@isStartingChat">
                            @foreach (var item in catalogItems)
                            {
                                <MudSelectItem Value="@item">@item.Name (@GetKindLabel(item))</MudSelectItem>
                            }
                        </MudSelect>

                        @if (inputDefinitions.Count > 0)
                        {
                            <MudStack Spacing="0" Class="app-compact-section">
                                @foreach (var input in inputDefinitions)
                                {
                                    @switch (input.Kind)
                                    {
                                        case AgentInputDefinitionKind.Json:
                                        case AgentInputDefinitionKind.MarkdownDocument:
                                            <MudTextField T="string"
                                                          Label="@GetInputLabel(input)"
                                                          HelperText="@input.Description"
                                                          Value="GetInputValue(input)"
                                                          ValueChanged="async value => await SetInputValueAsync(input.Key, value)"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="@input.Placeholder"
                                                          Lines="6"
                                                          AutoGrow="true"
                                                          Disabled="@isStartingChat" />
                                            break;

                                        case AgentInputDefinitionKind.Boolean:
                                            <MudSwitch T="bool"
                                                       Label="@GetInputLabel(input)"
                                                       Value="GetBooleanInputValue(input)"
                                                       ValueChanged="async value => await SetBooleanInputValueAsync(input.Key, value)"
                                                       Color="Color.Primary"
                                                       Disabled="@isStartingChat" />
                                            if (!string.IsNullOrWhiteSpace(input.Description))
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@input.Description</MudText>
                                            }
                                            break;

                                        default:
                                            <MudTextField T="string"
                                                          Label="@GetInputLabel(input)"
                                                          HelperText="@input.Description"
                                                          Value="GetInputValue(input)"
                                                          ValueChanged="async value => await SetInputValueAsync(input.Key, value)"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="@input.Placeholder"
                                                          InputType="@(input.Kind == AgentInputDefinitionKind.Number ? InputType.Number : InputType.Text)"
                                                          Disabled="@isStartingChat" />
                                            break;
                                    }
                                }
                            </MudStack>
                        }

                        @if (selectedDefinition?.LaunchCapabilities.SupportsMcpBindingOverrides == true)
                        {
                            <McpServerBindingsEditor Bindings="@mcpServerBindings"
                                                     BindingsChanged="OnMcpServerBindingsChanged"
                                                     Title="MCP Servers"
                                                     Description="Session-specific MCP bindings for this launch."
                                                     Disabled="@isStartingChat" />
                        }

                        @if (selectedDefinition?.LaunchCapabilities.SupportsWorkspace == true)
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudTextField T="string" Label="Workspace" Value="fileAccessWorkspace"
                                              ValueChanged="OnFileAccessWorkspaceChanged" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Immediate="true" Class="flex-grow-1"
                                              Disabled="@isStartingChat" />
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="OpenWorkspacePickerAsync" Disabled="@isStartingChat">Open...</MudButton>
                                    <MudTooltip Text="Enter a workspace name to create it under the configured Workspaces root.">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="CreateWorkspaceAsync"
                                                   Disabled="@(isStartingChat || !WorkspaceDirectoryService.IsValidWorkspaceName(fileAccessWorkspace))">Create</MudButton>
                                    </MudTooltip>
                                </MudStack>
                            </MudStack>
                        }
                        @if (selectedDefinition?.LaunchCapabilities.SupportsSandboxProfile == true)
                        {
                            <MudSelect T="Guid?" Label="Sandbox profile" Value="sandboxProfileId" ValueChanged="OnSandboxProfileChanged" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Disabled="@isStartingChat">
                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Select sandbox profile</MudSelectItem>
                                @foreach (var profile in sandboxProfiles)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)profile.Id)">@profile.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }

                        @if (!isStartingChat && launchValidation.Problems.Count > 0)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">
                                @string.Join(" ", launchValidation.Problems.Select(problem => problem.Message))
                            </MudAlert>
                        }
                        @if (isValidatingLaunch)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        }
                        @if (isStartingChat)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary app-preformatted-status">
                                @startStatus
                            </MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(startError))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">
                                @startError
                            </MudAlert>
                        }

                        <MudTooltip Text="Select server and model" Disabled="@CanStartChat">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Small"
                                       Disabled="@(!CanStartChat)"
                                       OnClick="StartChat">
                                @if (isStartingChat)
                                {
                                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>STARTING...</span>
                                }
                                else
                                {
                                    <span>Start Chat</span>
                                }
                            </MudButton>
                        </MudTooltip>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    }
    else
    {
        @if (ChatService.ActiveSession?.RuntimeReference.Kind == AgentDefinitionKind.SavedAgent)
        {
        <MudStack Row="true" Spacing="1" Class="mb-2">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@(isLLMAnswering || ChatService.PendingToolApproval is not null || ChatService.RequiresReset)" OnClick="ExportHarnessSessionAsync">
                Export Harness Session
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="@(isLLMAnswering || ChatService.PendingToolApproval is not null || ChatService.RequiresReset)" OnClick="OpenHarnessSessionPickerAsync">
                Restore Harness Session
            </MudButton>
            <InputFile id="harness-session-file" OnChange="RestoreHarnessSessionAsync" accept="application/json,.json" class="app-hidden-input" />
        </MudStack>
        }
        <AgenticChatSession @ref="chatSessionView"
                            Messages="ChatViewModelService.Messages"
                            Agents="DisplayedAgents"
                            IsLlmAnswering="isLLMAnswering"
                            HasHarnessTrace="@(ChatService.ActiveSession?.RuntimeReference.Kind == AgentDefinitionKind.SavedAgent)"
                            SessionState="ChatViewModelService.SessionState"
                            PendingToolApproval="ChatService.PendingToolApproval"
                            RequiresReset="ChatService.RequiresReset"
                            UserName="@userSettings.UserName"
                            OnAgentModeChanged="SetAgentModeAsync"
                            OnFileAccessWorkspaceChanged="SetFileAccessWorkspaceAsync"
                            OnViewFileMemory="ViewFileMemoryAsync"
                            OnClearFileMemory="ClearFileMemoryAsync"
                            OnToolApprovalDecision="RespondToToolApprovalAsync"
                            OnSendMessage="SendChatMessageAsync"
                            OnStop="Cancel"
                            OnCopyChat="CopyChatAsync" />
    }
    </MudStack>
</OllamaCheck>

@code {
    private const string DefaultAgentName = "Default Assistant";

    private List<AgentDefinitionDescriptor> catalogItems = new();
    private AgentDefinitionDescriptor? selectedDefinition { get; set; }
    private IReadOnlyList<AgentInputDefinition> inputDefinitions = [];
    private readonly Dictionary<string, string> inputValues = new(StringComparer.OrdinalIgnoreCase);
    private List<McpServerSessionBinding> mcpServerBindings = [];
    private List<SandboxProfile> sandboxProfiles = [];
    private string fileAccessWorkspace = string.Empty;
    private Guid? sandboxProfileId;
    private AgentDefinitionLaunchValidation launchValidation = new()
    {
        CanLaunch = false
    };
    private long validationVersion;
    private bool isValidatingLaunch;
    private bool isStartingChat;
    private string? startStatus;
    private string? startError;
    private ServerModelSelection previousUiModelSelection = new(null, null);

    [Inject]
    private IAgentDefinitionCatalog AgentDefinitionCatalog { get; set; } = null!;

    [Inject]
    private IAgentSessionDefinitionResolver SessionDefinitionResolver { get; set; } = null!;

    [Inject]
    private ISandboxProfileService SandboxProfileService { get; set; } = null!;

    [Inject]
    private IWorkspaceDirectoryService WorkspaceDirectoryService { get; set; } = null!;

    [CascadingParameter(Name = "UiModelSelection")]
    public ServerModelSelection UiModelSelection { get; set; } = new(null, null);

    private ServerModel? effectiveModel;

    private bool CanStartChat => launchValidation.CanLaunch && !isValidatingLaunch && !isStartingChat;

    private IReadOnlyCollection<AgentExecutionSpec> DisplayedAgents =>
        selectedDefinition is null && ChatService.HasActiveSession
            ? ChatService.Agents.Select(static agent =>
            {
                var displayAgent = agent.Clone();
                displayAgent.AgentName = "Active session";
                return displayAgent;
            }).ToList()
            : ChatService.Agents;

    protected override bool CanSendMessages => ChatService.HasActiveSession;

    protected override AgentDefinitionReference? CurrentRuntimeReference =>
        ChatService.ActiveSession?.RuntimeReference ?? selectedDefinition?.Reference;

    protected override async Task LoadAgentsAsync()
    {
        catalogItems = (await AgentDefinitionCatalog.GetAllAsync()).ToList();
        sandboxProfiles = (await SandboxProfileService.GetAllAsync())
            .OrderBy(static profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (ChatService.ActiveSession is { } activeSession)
        {
            selectedDefinition = catalogItems.FirstOrDefault(item => item.Reference == activeSession.RuntimeReference);
            if (selectedDefinition is null)
            {
                Logger.LogWarning(
                    "The active chat session definition {RuntimeReference} is no longer available in the catalog.",
                    activeSession.RuntimeReference);
            }

            RestoreActiveSession(activeSession);
            chatStarted = true;
            isLLMAnswering = ChatService.IsAnswering;
            return;
        }

        SetSelectedDefinition(GetDefaultDefinition());
        await RefreshLaunchValidationAsync();
    }

    protected override async Task OnChatResetCoreAsync()
    {
        SetSelectedDefinition(GetDefaultDefinition());
        await RefreshLaunchValidationAsync();
    }

    protected override async Task OnParametersSetCoreAsync()
    {
        if (SameSelection(previousUiModelSelection, UiModelSelection))
            return;

        previousUiModelSelection = UiModelSelection;
        await RefreshLaunchValidationAsync();
    }

    protected override async Task LoadUserSettingsAsync()
    {
        userSettings = await UserSettingsService.GetSettingsAsync();
    }

    private async Task StartChat()
    {
        if (isStartingChat || selectedDefinition is null)
            return;

        isStartingChat = true;
        startError = null;
        chatStarted = false;
        SetStartStatus("Resolving agent configuration...");
        StateHasChanged();

        try
        {
            var resolved = await SessionDefinitionResolver.ResolveAsync(selectedDefinition.Reference, new AgentSessionDefinitionRequest
            {
                UiModelSelection = UiModelSelection,
                Inputs = BuildInputs(),
                Overrides = BuildOverrides()
            });
            if (!resolved.Validation.CanLaunch)
            {
                startError = string.Join(" ", resolved.Validation.Problems.Select(problem => problem.Message));
                Snackbar.Add(startError, Severity.Error);
                return;
            }
            effectiveModel = resolved.DefaultModel;

            var chatConfiguration = new AppChatConfiguration(resolved.DefaultModel?.ModelName ?? string.Empty, []);
            var request = new ChatEngineSessionStartRequest
            {
                Configuration = chatConfiguration,
                Agents = [],
                RuntimeParticipant = resolved.PresentationParticipant,
                RuntimeReference = resolved.RuntimeReference,
                RuntimeDefaultModel = resolved.DefaultModel,
                RuntimeInputs = resolved.Inputs,
                Overrides = BuildOverrides()
            };
            var progress = new Progress<ChatSessionStartProgress>(value =>
            {
                startStatus = value.Message;
                _ = InvokeAsync(StateHasChanged);
            });

            await ChatService.StartAsync(request, progress: progress);
            chatStarted = true;
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Chat session startup was canceled.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start chat session.");
            startError = $"Could not start chat: {ex.Message}";
            Snackbar.Add(startError, Severity.Error);
        }
        finally
        {
            isStartingChat = false;
            if (!chatStarted)
            {
                startStatus = null;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetStartStatus(string message) => startStatus = message;

    private async Task ExportHarnessSessionAsync()
    {
        try
        {
            var json = await ChatService.ExportHarnessSessionAsync();
            await JSRuntime.InvokeVoidAsync("downloadTextFile", "ollamachat-harness-session.json", json);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Harness session export failed.");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Task OpenHarnessSessionPickerAsync() => JSRuntime.InvokeVoidAsync("clickElement", "harness-session-file").AsTask();

    private async Task RestoreHarnessSessionAsync(InputFileChangeEventArgs args)
    {
        try
        {
            using var reader = new StreamReader(args.File.OpenReadStream(10 * 1024 * 1024));
            await ChatService.RestoreHarnessSessionAsync(await reader.ReadToEndAsync());
            Snackbar.Add("Harness session restored.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Harness session restore failed.");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnDefinitionChanged(AgentDefinitionDescriptor? item)
    {
        SetSelectedDefinition(item);
        await RefreshLaunchValidationAsync();
    }

    private void SetSelectedDefinition(AgentDefinitionDescriptor? item)
    {
        selectedDefinition = item;
        inputDefinitions = item?.Inputs ?? [];
        inputValues.Clear();
        mcpServerBindings = item?.DefaultMcpServerBindings
            .Select(static binding => binding.Clone())
            .ToList() ?? [];
        fileAccessWorkspace = string.Empty;
        sandboxProfileId = sandboxProfiles.FirstOrDefault(profile =>
            string.Equals(profile.Name, ".NET 10 Small", StringComparison.OrdinalIgnoreCase))?.Id;
        foreach (var input in inputDefinitions)
        {
            if (input.Kind == AgentInputDefinitionKind.Boolean)
                inputValues[input.Key] = input.DefaultValue is not null
                    ? NormalizeBoolean(input.DefaultValue)
                    : bool.FalseString;
            else if (input.DefaultValue is not null)
                inputValues[input.Key] = input.DefaultValue;
        }
    }

    private AgentDefinitionDescriptor? GetDefaultDefinition() =>
        catalogItems.FirstOrDefault(item =>
            string.Equals(item.Name, DefaultAgentName, StringComparison.OrdinalIgnoreCase)) ?? catalogItems.FirstOrDefault();

    private void RestoreActiveSession(ActiveChatSessionInfo activeSession)
    {
        inputDefinitions = selectedDefinition?.Inputs ?? [];
        inputValues.Clear();
        foreach (var input in activeSession.Inputs)
        {
            inputValues[input.Key] = input.Value;
        }

        mcpServerBindings = activeSession.Overrides.McpServerBindings?
            .Select(static binding => binding.Clone())
            .ToList() ?? [];
        fileAccessWorkspace = activeSession.Overrides.WorkspacePath ?? string.Empty;
        sandboxProfileId = activeSession.Overrides.SandboxProfileId;
        effectiveModel = activeSession.Model;
    }

    private static string GetKindLabel(AgentDefinitionDescriptor item) =>
        item.RuntimeKind == AgentRuntimeKind.WorkflowAgent ? "workflow" : "agent";

    private IReadOnlyDictionary<string, string> BuildInputs() =>
        inputDefinitions
            .Where(input => inputValues.TryGetValue(input.Key, out var value) &&
                            (!string.IsNullOrWhiteSpace(value) || input.Kind == AgentInputDefinitionKind.Boolean))
            .ToDictionary(
                input => input.Key,
                input => inputValues[input.Key],
                StringComparer.OrdinalIgnoreCase);

    private string GetInputValue(AgentInputDefinition input) =>
        inputValues.TryGetValue(input.Key, out var value)
            ? value
            : input.DefaultValue ?? string.Empty;

    private async Task SetInputValueAsync(string key, string? value)
    {
        inputValues[key] = value ?? string.Empty;
        await RefreshLaunchValidationAsync();
    }

    private bool GetBooleanInputValue(AgentInputDefinition input) =>
        bool.TryParse(GetInputValue(input), out var value) && value;

    private async Task SetBooleanInputValueAsync(string key, bool value)
    {
        inputValues[key] = value.ToString();
        await RefreshLaunchValidationAsync();
    }

    private static string GetInputLabel(AgentInputDefinition input) =>
        input.IsRequired ? $"{input.DisplayName} *" : input.DisplayName;

    private async Task OnMcpServerBindingsChanged(List<McpServerSessionBinding> bindings)
    {
        mcpServerBindings = bindings;
        await RefreshLaunchValidationAsync();
    }

    private async Task OnFileAccessWorkspaceChanged(string value)
    {
        fileAccessWorkspace = value;
        await RefreshLaunchValidationAsync();
    }

    private async Task OpenWorkspacePickerAsync()
    {
        var initialPath = GetWorkspacePickerInitialPath();
        var parameters = new DialogParameters<WorkspaceDirectoryPickerDialog>
        {
            { dialog => dialog.InitialPath, initialPath }
        };
        var dialog = await DialogService.ShowAsync<WorkspaceDirectoryPickerDialog>(
            "Select workspace", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not string selectedPath)
            return;

        fileAccessWorkspace = selectedPath;
        await RefreshLaunchValidationAsync();
    }

    private async Task CreateWorkspaceAsync()
    {
        try
        {
            fileAccessWorkspace = WorkspaceDirectoryService.CreateWorkspace(userSettings.WorkspacesRoot, fileAccessWorkspace);
            await RefreshLaunchValidationAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not create workspace.");
            Snackbar.Add($"Could not create workspace: {ex.Message}", Severity.Error);
        }
    }

    private string GetWorkspacePickerInitialPath()
    {
        foreach (var candidate in new[]
                 {
                     fileAccessWorkspace,
                     userSettings.WorkspacesRoot,
                     Environment.GetFolderPath(Environment.SpecialFolder.UserProfile)
                 })
        {
            if (!string.IsNullOrWhiteSpace(candidate) && Directory.Exists(candidate))
                return WorkspaceDirectoryService.NormalizePath(candidate);
        }

        return WorkspaceDirectoryService.GetFileSystemRoots().FirstOrDefault() ?? Path.GetPathRoot(Environment.CurrentDirectory) ?? Environment.CurrentDirectory;
    }

    private async Task OnSandboxProfileChanged(Guid? value)
    {
        sandboxProfileId = value;
        await RefreshLaunchValidationAsync();
    }

    private AgentSessionOverrides BuildOverrides() => new()
    {
        McpServerBindings = selectedDefinition?.LaunchCapabilities.SupportsMcpBindingOverrides == true
            ? mcpServerBindings
            : null,
        WorkspacePath = selectedDefinition?.LaunchCapabilities.SupportsWorkspace == true &&
                              !string.IsNullOrWhiteSpace(fileAccessWorkspace)
            ? fileAccessWorkspace
            : null,
        SandboxProfileId = selectedDefinition?.LaunchCapabilities.SupportsSandboxProfile == true
            ? sandboxProfileId
            : null
    };

    private async Task RefreshLaunchValidationAsync()
    {
        var version = System.Threading.Interlocked.Increment(ref validationVersion);
        if (selectedDefinition is null)
        {
            launchValidation = new AgentDefinitionLaunchValidation
            {
                CanLaunch = false
            };
            isValidatingLaunch = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        isValidatingLaunch = true;
        await InvokeAsync(StateHasChanged);

        var reference = selectedDefinition.Reference;
        var request = new AgentSessionDefinitionRequest
        {
            UiModelSelection = UiModelSelection,
            Inputs = BuildInputs(),
            Overrides = BuildOverrides()
        };

        try
        {
            var validation = await SessionDefinitionResolver.ValidateAsync(reference, request);
            if (version != System.Threading.Volatile.Read(ref validationVersion))
            {
                return;
            }

            launchValidation = validation;
        }
        catch (Exception ex)
        {
            if (version != System.Threading.Volatile.Read(ref validationVersion))
            {
                return;
            }

            Logger.LogWarning(ex, "Launch validation failed.");
            launchValidation = new AgentDefinitionLaunchValidation
            {
                CanLaunch = false,
                Problems = [new AgentDefinitionLaunchProblem(ex.Message)]
            };
        }
        finally
        {
            if (version == System.Threading.Volatile.Read(ref validationVersion))
            {
                isValidatingLaunch = false;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private static bool SameSelection(ServerModelSelection left, ServerModelSelection right) =>
        left.ServerId == right.ServerId &&
        string.Equals(left.ModelName, right.ModelName, StringComparison.Ordinal);

    private static string NormalizeBoolean(string value) =>
        bool.TryParse(value, out var parsed)
            ? parsed.ToString()
            : value;
}
