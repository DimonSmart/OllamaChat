@page "/file-access-provider-profiles"
@using ChatClient.Application.Services
@using ChatClient.Domain.Models
@inject IFileAccessProviderProfileService FileAccessProviderProfileService
@inject ISnackbar Snackbar

<PageTitle>File Access Provider Profiles</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="app-page">
    <MudText Class="page-header">File Access Provider Profiles</MudText>
    <MudPaper Elevation="3" Class="pa-3 rounded-lg">
        <MudToolBar Dense="true" Class="app-page-toolbar"><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="Create">Add File Access Profile</MudButton></MudToolBar>
        <MudDataGrid T="FileAccessProviderProfile" Items="profiles" Dense="true" Hover="true" Bordered="true" Class="mt-2">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.AccessMode" Title="Access" />
                <TemplateColumn Title="Read approval"><CellTemplate>@(context.Item.RequireReadApproval ? "Required" : "Not required")</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Write approval"><CellTemplate>@(context.Item.AccessMode == FileAccessMode.ReadOnly ? "—" : context.Item.RequireWriteApproval ? "Required" : "Not required")</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Actions"><CellTemplate><div class="app-table-actions"><MudTooltip Text="Edit profile"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" AriaLabel="Edit profile" OnClick="@(() => Edit(context.Item))" /></MudTooltip><MudTooltip Text="Delete profile"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" AriaLabel="Delete profile" OnClick="@(() => ConfirmDelete(context.Item))" /></MudTooltip></div></CellTemplate></TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

<MudDialog @bind-Visible="editing" Options="dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(isNew ? "Create File Access Provider Profile" : "Edit File Access Provider Profile")</MudText></TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12"><MudTextField @bind-Value="model.Name" Label="Name" Required="true" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="model.Instructions" Label="Instructions" Lines="6" Margin="Margin.Dense" HelperText="Leave empty to use Microsoft Agent Framework defaults." /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudSelect T="FileAccessMode" @bind-Value="model.AccessMode" Label="Access mode" Margin="Margin.Dense"><MudSelectItem Value="FileAccessMode.ReadOnly">Read-only</MudSelectItem><MudSelectItem Value="FileAccessMode.ReadWrite">Read-write</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudCheckBox @bind-Value="model.RequireReadApproval" Label="Require approval for reads" /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudCheckBox @bind-Value="model.RequireWriteApproval" Label="Require approval for writes" Disabled="@(model.AccessMode == FileAccessMode.ReadOnly)" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions><MudButton Size="Size.Small" OnClick="Close">Cancel</MudButton><MudButton Color="Color.Primary" Size="Size.Small" OnClick="Save">Save</MudButton></DialogActions>
</MudDialog>

<MudDialog @bind-Visible="deleting" Options="dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Delete File Access Provider Profile</MudText></TitleContent>
    <DialogContent><MudText>Delete "@profileToDelete?.Name"?</MudText></DialogContent>
    <DialogActions><MudButton Size="Size.Small" OnClick="CloseDelete">Cancel</MudButton><MudButton Color="Color.Error" Size="Size.Small" OnClick="DeleteConfirmed">Delete</MudButton></DialogActions>
</MudDialog>

@code {
    private List<FileAccessProviderProfile> profiles = [];
    private FileAccessProviderProfile model = new();
    private bool editing;
    private bool isNew;
    private bool deleting;
    private FileAccessProviderProfile? profileToDelete;
    private readonly DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => profiles = (await FileAccessProviderProfileService.GetAllAsync()).OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList();
    private void Create() { model = new(); isNew = true; editing = true; }
    private void Edit(FileAccessProviderProfile value) { model = new() { Id = value.Id, Name = value.Name, Instructions = value.Instructions, AccessMode = value.AccessMode, RequireReadApproval = value.RequireReadApproval, RequireWriteApproval = value.RequireWriteApproval, CreatedAt = value.CreatedAt, UpdatedAt = value.UpdatedAt }; isNew = false; editing = true; }
    private async Task Save() { try { if (isNew) await FileAccessProviderProfileService.CreateAsync(model); else await FileAccessProviderProfileService.UpdateAsync(model); editing = false; await Load(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } }
    private void ConfirmDelete(FileAccessProviderProfile value) { profileToDelete = value; deleting = true; }
    private async Task DeleteConfirmed() { if (profileToDelete is null) return; try { await FileAccessProviderProfileService.DeleteAsync(profileToDelete.Id); deleting = false; await Load(); } catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); } }
    private void Close() => editing = false;
    private void CloseDelete() => deleting = false;
}
