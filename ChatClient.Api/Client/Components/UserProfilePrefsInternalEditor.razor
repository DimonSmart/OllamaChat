@using ChatClient.Api.Services.BuiltIn
@using ChatClient.Domain.Models
@inject UserProfileEditorService ProfileEditorService
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudStack AlignItems="AlignItems.Center" Class="py-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else
{
    <MudStack Spacing="3">
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
            Storage file: @_storageFilePath
        </MudAlert>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save" Size="Size.Small"
                       Disabled="@_saving" OnClick="SaveAsync">Save</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_saving" OnClick="ReloadAsync">Reload</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@_saving" OnClick="AddField">Add field</MudButton>
        </MudStack>
        <MudTable Items="@_rows" Dense="true" Hover="true" Striped="true"
                  Bordered="true" Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh Class="user-profile-key-column">Key</MudTh>
                <MudTh>Value</MudTh>
                <MudTh Class="user-profile-actions-column"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Key">
                    <MudTextField T="string" Value="@context.Key"
                                  ValueChanged="value => context.Key = value ?? string.Empty"
                                  Immediate="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="Value">
                    <MudTextField T="string" Value="@context.Value"
                                  ValueChanged="value => context.Value = value ?? string.Empty"
                                  Immediate="true" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error" Size="Size.Small"
                                   aria-label="Delete field"
                                   OnClick="@(() => _rows.Remove(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudStack>
}

@code {
    [Parameter] public IMcpServerDescriptor? ServerDescriptor { get; set; }

    private readonly List<ProfileRow> _rows = [];
    private bool _loading = true;
    private bool _saving;
    private string _storageFilePath = string.Empty;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _loading = true;
            _storageFilePath = ProfileEditorService.StorageFilePath;
            var values = await ProfileEditorService.GetAsync();
            _rows.Clear();
            _rows.AddRange(values.OrderBy(static pair => pair.Key, StringComparer.OrdinalIgnoreCase)
                .Select(static pair => new ProfileRow { Key = pair.Key, Value = pair.Value }));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load user profile: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            _saving = true;
            var values = BuildValues();
            await ProfileEditorService.SaveAsync(values);
            Snackbar.Add("User profile saved.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save user profile: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddField() => _rows.Add(new ProfileRow());

    private Dictionary<string, string> BuildValues()
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in _rows)
        {
            var key = row.Key.Trim();
            var value = row.Value.Trim();
            if (key.Length == 0)
            {
                if (value.Length != 0)
                    throw new InvalidOperationException("Key is required for a non-empty value.");
                continue;
            }

            if (!seen.Add(key))
                throw new InvalidOperationException($"Duplicate profile key '{key}'.");

            if (value.Length != 0)
                values.Add(key, value);
        }

        return values;
    }

    private sealed class ProfileRow
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }
}
