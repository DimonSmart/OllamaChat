@using ChatClient.Domain.Models

<MudGrid Spacing="2">
<MudItem xs="12"><MudTextField @bind-Value="Server.Name"
              Label="Server Name"
              Required="true"
              Immediate="true"
              Margin="Margin.Dense" /></MudItem>

<MudItem xs="12" sm="6"><MudSelect T="ServerType" @bind-Value="Server.ServerType" Label="Server Type" Dense="true" Margin="Margin.Dense">
    <MudSelectItem Value="ServerType.Ollama">Ollama</MudSelectItem>
    <MudSelectItem Value="ServerType.ChatGpt">ChatGPT</MudSelectItem>
    <MudSelectItem Value="ServerType.Azure">Azure</MudSelectItem>
</MudSelect></MudItem>

<MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="Server.HttpTimeoutSeconds"
                 Label="HTTP Timeout (seconds)"
                 Variant="Variant.Outlined"
                 Min="1" Max="3600"
                 Margin="Margin.Dense" /></MudItem>

<MudItem xs="12"><MudTextField @bind-Value="Server.BaseUrl"
              Label="Base URL"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Required="@(Server.ServerType == ServerType.Ollama)"
              HelperText="@GetBaseUrlHelperText()" /></MudItem>

@if (Server.ServerType is ServerType.ChatGpt or ServerType.Azure)
{
    <MudItem xs="12" sm="6"><MudTextField @bind-Value="Server.ApiKey"
                  Label="API Key"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                   InputType="InputType.Password"
                   HelperText="Optional inline key. Leave empty to use the local secret store." /></MudItem>

    <MudItem xs="12" sm="6"><MudTextField @bind-Value="Server.ApiKeySecretName"
                  Label="API Key Secret Name"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                   HelperText="Optional secret alias. The app resolves LlmServers:ApiKeys:<name> from dotnet user-secrets." /></MudItem>
}

@if (Server.ServerType == ServerType.Azure)
{
    <MudItem xs="12"><MudTextField @bind-Value="Server.AzureDeploymentNamesText"
                  Label="Deployments"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                   Lines="6"
                   HelperText="One deployment name per line. These names are shown in the model picker and used in Azure chat requests." /></MudItem>
}

@if (Server.ServerType == ServerType.Ollama)
{
    <MudItem xs="12" sm="6"><MudTextField @bind-Value="Server.Password"
                  Label="Password"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  Margin="Margin.Dense"
                   HelperText="Optional password for Ollama server" /></MudItem>
}

@if (Server.ServerType == ServerType.Ollama)
{
    <MudItem xs="12" sm="6"><MudSwitch @bind-Value="Server.IgnoreSslErrors">
        Ignore SSL certificate errors
    </MudSwitch></MudItem>
}
</MudGrid>

@code {
    [Parameter] public LlmServerConfig Server { get; set; } = new();

    private string GetBaseUrlHelperText()
    {
        return Server.ServerType switch
        {
            ServerType.Ollama => "Ollama server URL (e.g., http://localhost:11434)",
            ServerType.ChatGpt => "OpenAI-compatible base URL (e.g., https://api.openai.com/v1/).",
            ServerType.Azure => "Azure OpenAI resource URL (e.g., https://your-resource.openai.azure.com/). The app will map it to /openai/v1/.",
            _ => ""
        };
    }
}
