@using Microsoft.AspNetCore.Components
@using MudBlazor
@using MudX
@using ChatClient.Domain.Models

<MudXChatBubble Class="@($"mcp-call {(isExpanded ? "expanded" : "collapsed")}")" OnClick="Toggle">
    @if (isExpanded)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mcp-call-header">
            <strong>@ToolDisplayName</strong> — @Call.Status
        </MudText>
        <MudText Typo="Typo.caption" Class="mcp-call-label">Request:</MudText>
        <pre class="mcp-call-pre">@Call.Arguments</pre>
        @if (Call.Status == ToolInvocationStatus.Running)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Info" />
        }
        else if (Call.Status == ToolInvocationStatus.Succeeded)
        {
            <MudText Typo="Typo.caption" Class="mcp-call-label">Response:</MudText>
            <pre class="mcp-call-pre">@Call.Result</pre>
        }
        else
        {
            <MudAlert Severity="@(Call.Status == ToolInvocationStatus.Canceled ? Severity.Warning : Severity.Error)" Dense="true">
                @(Call.Status == ToolInvocationStatus.Canceled ? "Canceled" : Call.Error)
            </MudAlert>
        }
    }
    else
    {
        <div class="mcp-call-summary">
            <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Class="mcp-call-tool-icon" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary font-italic mcp-call-summary-text">
                @ToolDisplayName
            </MudText>
            <MudTooltip Text="@Call.Status.ToString()">
                <MudIcon Icon="@StatusIcon" Color="@StatusColor" Size="Size.Small" Class="@StatusIconClass" />
            </MudTooltip>
        </div>
    }
</MudXChatBubble>

@code {
    [Parameter, EditorRequired]
    public ToolInvocationViewState Call { get; set; } = null!;

    private bool isExpanded;
    private string ToolDisplayName =>
        string.Equals(Call.ServerName, "unknown", StringComparison.OrdinalIgnoreCase)
            ? Call.OriginalName.Replace('_', ' ')
            : $"{Call.ServerName}.{Call.OriginalName}";

    private string StatusIcon => Call.Status switch
    {
        ToolInvocationStatus.Running => Icons.Material.Filled.Sync,
        ToolInvocationStatus.Succeeded => Icons.Material.Filled.CheckCircle,
        ToolInvocationStatus.Canceled => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Error
    };

    private Color StatusColor => Call.Status switch
    {
        ToolInvocationStatus.Running => Color.Info,
        ToolInvocationStatus.Succeeded => Color.Success,
        ToolInvocationStatus.Canceled => Color.Warning,
        _ => Color.Error
    };

    private string StatusIconClass =>
        Call.Status == ToolInvocationStatus.Running
            ? "mcp-call-status-icon mcp-call-status-running"
            : "mcp-call-status-icon";

    private void Toggle() => isExpanded = !isExpanded;
}
