@using System.Linq
@using ChatClient.Api.Client.Services
@using ChatClient.Api.Client.Services.Agentic
@using ChatClient.Api.Client.ViewModels
@using ChatClient.Application.Services.Agentic
@using ChatClient.Domain.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using MudBlazor
@using MudX
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ILogger<AgenticChatSession> Logger
@inject ChatToolbarState ChatToolbar

<MudDrawerContainer Class="session-state-drawer-container">
    @if (SessionState is not null)
    {
        <MudDrawer @bind-Open="showSessionState"
                   Anchor="Anchor.Right"
                   Variant="DrawerVariant.Temporary"
                   Fixed="true"
                   Overlay="false"
                   Elevation="8"
                   Width="min(26rem, 100%)"
                   Class="session-state-drawer">
            @{
                var fileAccess = SessionState.FileAccess;
                var sandbox = SessionState.Sandbox;
                var workspacePath = fileAccess?.WorkspacePath ?? sandbox?.WorkspacePath;
            }
            <div class="session-state-drawer-layout">
                <div class="session-state-drawer-header">
                    <MudText Typo="Typo.subtitle2">Session state</MudText>
                    <MudTooltip Text="Close session state" Placement="Placement.Left">
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       AriaLabel="Close session state"
                                       OnClick="CloseSessionState" />
                    </MudTooltip>
                </div>
                <div class="session-state-drawer-content">
                    @if (SessionState.HasAgentModeProvider)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Mode</MudText>
                            @if (SessionState.AvailableModes.Count == 1)
                            {
                                <MudText Typo="Typo.body2" Class="session-state-value" title="@SessionState.Mode">@SessionState.Mode</MudText>
                            }
                            else
                            {
                                <MudSelect T="string" Value="SessionState.Mode" ValueChanged="OnAgentModeChangedAsync" Dense="true" Margin="Margin.Dense" Disabled="@(IsLlmAnswering || isChangingAgentMode || PendingToolApproval is not null)" Style="min-width: 130px">
                                    @foreach (var mode in SessionState.AvailableModes)
                                    {
                                        <MudSelectItem T="string" Value="@mode">@mode</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </MudStack>
                    }
                    @if (SessionState.Compaction is { } compaction)
                    {
                        <MudStack Class="mt-2" Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Compaction</MudText>
                            <MudText Typo="Typo.body2" Class="session-state-value" title="@compaction.ProfileName">@compaction.ProfileName</MudText>
                            <MudText Typo="Typo.caption" Class="session-state-value" title="@compaction.PolicySummary">@compaction.PolicySummary</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Input budget</MudText>
                            <MudText Typo="Typo.body2">@compaction.InputBudgetTokens.ToString("N0") tokens</MudText>
                        </MudStack>
                    }
                    @if ((SessionState.Skills?.Count ?? 0) > 0 || (SessionState.SkillDiagnostics?.Count ?? 0) > 0)
                    {
                        <MudStack Class="mt-2" Spacing="1"><MudText Typo="Typo.caption" Class="mud-text-secondary">Skills: @(SessionState.Skills?.Count ?? 0)</MudText>@foreach (var skill in SessionState.Skills ?? []) { <MudText Typo="Typo.caption" title="@skill.SourcePath">@skill.Name — @skill.Description</MudText> } @if (SessionState.SkillDiagnostics is { Count: > 0 } diagnostics) { <MudText Typo="Typo.caption" Class="mud-text-secondary">@diagnostics.Count ignored</MudText>@foreach (var diagnostic in diagnostics) { <MudText Typo="Typo.caption">@diagnostic</MudText> } }</MudStack>
                    }
                    @if ((SessionState.BackgroundAgents?.Count ?? 0) > 0)
                    {
                        <MudStack Class="mt-2" Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Background Agents (@SessionState.BackgroundAgents!.Count)</MudText>
                            @foreach (var agent in SessionState.BackgroundAgents)
                            {
                                <MudText Typo="Typo.caption" title="@agent.Summary">@agent.Name@(string.IsNullOrWhiteSpace(agent.Summary) ? string.Empty : $" — {agent.Summary}")</MudText>
                            }
                        </MudStack>
                    }
                    @if (SessionState.HasTodoProvider)
                    {
                        var completed = SessionState.Todos.Count(todo => todo.IsComplete);
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">TODO</MudText>
                            @if (SessionState.Todos.Count > 0)
                            {
                                <MudText Typo="Typo.caption">@completed/@SessionState.Todos.Count</MudText>
                            }
                        </MudStack>
                        @if (SessionState.Todos.Count == 0)
                        {
                            <MudText Typo="Typo.caption">No tasks</MudText>
                        }
                        else
                        {
                            @foreach (var todo in SessionState.Todos)
                            {
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="session-state-todo">
                                    <MudIcon Icon="@(todo.IsComplete ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Color="@(todo.IsComplete ? Color.Success : Color.Default)" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Class="@(todo.IsComplete ? "session-state-todo-complete session-state-value" : "session-state-value")" title="@todo.Title">@todo.Title</MudText>
                                </MudStack>
                            }
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(workspacePath))
                    {
                        <MudStack Class="mt-2" Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Workspace</MudText>
                            @if (fileAccess is not null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2" Class="session-state-value" title="@fileAccess.WorkspacePath">@fileAccess.WorkspacePath</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="session-state-value" title="@workspacePath">@workspacePath</MudText>
                            }
                        </MudStack>
                    }
                    @if (fileAccess is not null)
                    {
                        <MudStack Class="mt-2" Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">File access profile</MudText>
                            <MudText Typo="Typo.body2" Class="session-state-value" title="@fileAccess.ProfileName">@fileAccess.ProfileName</MudText>
                        </MudStack>
                    }
                    @if (sandbox is not null)
                    {
                        <MudStack Class="mt-2" Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Sandbox</MudText>
                            <MudText Typo="Typo.body2" Class="session-state-value" title="@sandbox.ProfileName">@sandbox.ProfileName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Image</MudText>
                            <MudText Typo="Typo.body2" Class="session-state-value" title="@sandbox.Image">@sandbox.Image</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">State</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@sandbox.State</MudChip>
                        </MudStack>
                    }
                </div>
            </div>
        </MudDrawer>
    }

    <div class="chat-messages-container">
    @{
        var messageIndex = 0;
    }
    @foreach (var message in Messages)
    {
        if (message.Role == AppChatRole.System)
        {
            continue;
        }

        messageIndex++;
            <MudXChat Dense="true" ChatPosition="@(message.Role == AppChatRole.Assistant ? ChatBubblePosition.Start : ChatBubblePosition.End)" @key="@($"{messageIndex}_{message.Id}")">
                <MudXChatHeader>
                    <time>@message.MsgDateTime.ToString("g")</time>
                    <CopyButton Text="@message.Content"
                                Tooltip="Copy answer"
                                AriaLabel="Copy answer"
                                Size="Size.Small"
                                Class="chat-message-action" />
                    <CopyButton CopyTextFactory="@(() => GetRawContentAsync(message))"
                                Tooltip="Copy raw text"
                                AriaLabel="Copy raw text"
                                Icon="@Icons.Material.Filled.Description"
                                Size="Size.Small"
                                Class="chat-message-action"
                                Disabled="@string.IsNullOrWhiteSpace(message.RawContent)" />
                    @if (AllowMessageDeletion && !IsLlmAnswering)
                    {
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Class="chat-message-action"
                                           OnClick="@(() => OnDeleteMessage.InvokeAsync(message))" />
                        </MudTooltip>
                    }
                </MudXChatHeader>

                @{
                    var avatarText = message.Role == AppChatRole.Assistant
                        ? GetAssistantAvatarText(message.AgentId)
                        : GetAvatarText(UserName);
                    var avatarLabel = message.Role == AppChatRole.Assistant
                        ? GetAssistantLabel(message)
                        : UserName;
                }

                @if (!string.IsNullOrEmpty(avatarText))
                {
                    @if (!string.IsNullOrWhiteSpace(avatarLabel))
                    {
                        <MudTooltip Text="@avatarLabel">
                            <MudAvatar Class="chat-avatar" Color="@(message.Role == AppChatRole.Assistant ? Color.Primary : Color.Secondary)">
                                @avatarText
                            </MudAvatar>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudAvatar Class="chat-avatar" Color="@(message.Role == AppChatRole.Assistant ? Color.Primary : Color.Secondary)">
                            @avatarText
                        </MudAvatar>
                    }
                }

                <MudXChatBubble Class="@(message.Role == AppChatRole.User ? "chat-user-bubble" : null)">
                    @if (ShouldShowSpeakerLabel(message))
                    {
                        <MudText Typo="Typo.caption" Class="chat-speaker-label">
                            @GetSpeakerLabel(message)
                        </MudText>
                    }

                    @if (message.Files.Any())
                    {
                        <div class="mb-2">
                            @foreach (var file in message.Files)
                            {
                                @if (IsImageFile(file.ContentType))
                                {
                                    <div class="image-thumbnail">
                                        <img src="@GetImageDataUrl(file)"
                                             alt="@file.Name"
                                             style="max-width: 150px; max-height: 150px; object-fit: cover;"
                                             @onclick="@(() => ShowFullSizeImage(file))" />
                                        <MudText Typo="Typo.caption" Class="image-caption mt-1 text-center">
                                            @file.Name (@FormatFileSize(file.Size))
                                        </MudText>
                                    </div>
                                }
                                else
                                {
                                    <MudChip T="string"
                                             Color="Color.Info"
                                             Size="Size.Small"
                                             Class="mb-1 mr-1">
                                        <MudIcon Icon="@GetFileIcon(file.ContentType)" Class="mr-1" />
                                        @file.Name (@FormatFileSize(file.Size))
                                    </MudChip>
                                }
                            }
                        </div>
                    }
                    <div class="chat-markdown-content">
                        @((MarkupString)message.HtmlContent)
                    </div>
                </MudXChatBubble>

                @if (message.ThinkSegments.Any())
                {
                    foreach (var thought in GetValidThoughts(message))
                    {
                        <ThoughtDisplay PlainText="@thought.PlainText" HtmlText="@thought.HtmlText" />
                    }
                }

                @if (message.Role == AppChatRole.Assistant && message.RagRetrievals.Any())
                {
                    <RagRetrievalDisplay Traces="message.RagRetrievals" />
                }

                @if (message.ToolInvocations.Any())
                {
                    foreach (var call in message.ToolInvocations.Where(call =>
                        !string.Equals(call.OriginalName, RagToolNames.SearchAgentKnowledge, StringComparison.Ordinal) ||
                        !message.RagRetrievals.Any(trace => trace.Status is RagRetrievalTraceStatus.Succeeded or RagRetrievalTraceStatus.NoResults)))
                    {
                        <ToolCallDisplay Call="@call" />
                    }
                }

                @if (message.IsStreaming || message.IsCanceled || !string.IsNullOrEmpty(message.Statistics))
                {
                    <MudXChatFooter>
                        @if (message.IsStreaming)
                        {
                            <MudText Typo="Typo.caption" Class="typing-indicator">typing...</MudText>
                        }
                        @if (message.IsCanceled)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">
                                Canceled
                            </MudAlert>
                        }
                        @if (!string.IsNullOrEmpty(message.Statistics))
                        {
                            <div class="mt-1">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @((MarkupString)message.Statistics)
                                </MudText>
                            </div>
                        }
                    </MudXChatFooter>
                }
        </MudXChat>
    }
    </div>
</MudDrawerContainer>

<div class="chat-input-panel">
    <MudStack>
        @if (RequiresReset)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                This conversation cannot continue after the canceled or failed run. Start a new chat to continue.
            </MudAlert>
        }
        <ChatInput OnSend="OnSendMessage"
                   Disabled="@(RequiresReset || PendingToolApproval is not null)"
                   ShowStopButton="@(IsLlmAnswering && PendingToolApproval is null)"
                   OnStopClick="OnStop"
                   IsMultiAgent="IsMultiAgent" />
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<AppChatMessageViewModel> Messages { get; set; } = Array.Empty<AppChatMessageViewModel>();

    [Parameter, EditorRequired]
    public IReadOnlyCollection<AgentExecutionSpec> Agents { get; set; } = Array.Empty<AgentExecutionSpec>();

    [Parameter]
    public bool IsLlmAnswering { get; set; }

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    [Parameter]
    public bool IsMultiAgent { get; set; }

    [Parameter]
    public bool AllowMessageDeletion { get; set; }

    [Parameter]
    public bool RequiresReset { get; set; }

    [Parameter]
    public AgentSessionStateViewModel? SessionState { get; set; }

    [Parameter]
    public ToolApprovalRequestViewModel? PendingToolApproval { get; set; }

    [Parameter]
    public EventCallback<(string text, IReadOnlyList<AppChatMessageFile> files)> OnSendMessage { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    [Parameter]
    public EventCallback<AppChatMessageViewModel> OnDeleteMessage { get; set; }

    [Parameter]
    public EventCallback<ChatFormat> OnCopyChat { get; set; }

    [Parameter]
    public EventCallback<string> OnAgentModeChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnFileAccessWorkspaceChanged { get; set; }

    [Parameter]
    public EventCallback<ToolApprovalDecision> OnToolApprovalDecision { get; set; }

    private bool showSessionState;
    private bool isChangingAgentMode;
    private bool isRespondingToToolApproval;
    private IDialogReference? toolApprovalDialog;
    private string? toolApprovalDialogRequestId;
    private bool disposed;
    private bool isChangingWorkspace;
    private string workspaceInput = string.Empty;

    protected override void OnParametersSet()
    {
        if (SessionState is null)
            showSessionState = false;

        if (SessionState?.FileAccess is { } fileAccess && !isChangingWorkspace)
            workspaceInput = fileAccess.WorkspacePath;

        PublishToolbarState();
        SynchronizeToolApprovalDialog();
    }

    public void Dispose()
    {
        disposed = true;
        CloseToolApprovalDialog();
        ChatToolbar.Clear();
    }

    private async Task ChangeWorkspaceAsync()
    {
        if (isChangingWorkspace || string.IsNullOrWhiteSpace(workspaceInput)) return;
        isChangingWorkspace = true;
        try { await OnFileAccessWorkspaceChanged.InvokeAsync(workspaceInput); }
        finally { isChangingWorkspace = false; }
    }

    private Task ToggleSessionStateAsync()
    {
        showSessionState = !showSessionState;
        PublishToolbarState();
        return Task.CompletedTask;
    }

    private void CloseSessionState()
    {
        showSessionState = false;
        PublishToolbarState();
    }

    private void PublishToolbarState() => ChatToolbar.Update(
        SessionState is not null,
        showSessionState,
        ToggleSessionStateAsync,
        format => OnCopyChat.InvokeAsync(format));

    private async Task OnAgentModeChangedAsync(string mode)
    {
        if (isChangingAgentMode || IsLlmAnswering ||
            string.Equals(mode, SessionState?.Mode, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        isChangingAgentMode = true;
        try
        {
            await OnAgentModeChanged.InvokeAsync(mode);
        }
        finally
        {
            isChangingAgentMode = false;
        }
    }

    private async Task RespondToToolApprovalAsync(ToolApprovalDecision decision)
    {
        if (isRespondingToToolApproval)
            return;

        isRespondingToToolApproval = true;
        try
        {
            await OnToolApprovalDecision.InvokeAsync(decision);
        }
        finally
        {
            isRespondingToToolApproval = false;
        }
    }

    private void SynchronizeToolApprovalDialog()
    {
        if (PendingToolApproval is null)
        {
            CloseToolApprovalDialog();
            return;
        }

        if (string.Equals(toolApprovalDialogRequestId, PendingToolApproval.RequestId, StringComparison.Ordinal)) return;
        CloseToolApprovalDialog();
        toolApprovalDialogRequestId = PendingToolApproval.RequestId;
        var request = PendingToolApproval;
        _ = InvokeAsync(async () =>
        {
            if (disposed || !string.Equals(PendingToolApproval?.RequestId, request.RequestId, StringComparison.Ordinal))
            {
                return;
            }

            var parameters = new DialogParameters<ToolApprovalDialog>
            {
                { dialog => dialog.Request, request },
                { dialog => dialog.OnDecision, EventCallback.Factory.Create<ToolApprovalDecision>(this, RespondToToolApprovalAsync) }
            };
            var dialog = await DialogService.ShowAsync<ToolApprovalDialog>(
                "Approval required", parameters,
                new DialogOptions { CloseButton = false, CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
            if (disposed || !string.Equals(PendingToolApproval?.RequestId, request.RequestId, StringComparison.Ordinal) ||
                !string.Equals(toolApprovalDialogRequestId, request.RequestId, StringComparison.Ordinal))
            {
                dialog.Close();
                return;
            }

            toolApprovalDialog = dialog;
        });
    }

    private void CloseToolApprovalDialog()
    {
        toolApprovalDialog?.Close();
        toolApprovalDialog = null;
        toolApprovalDialogRequestId = null;
    }

    public async Task ScrollToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to scroll to bottom");
        }
    }

    private static IEnumerable<(string PlainText, string HtmlText)> GetValidThoughts(AppChatMessageViewModel message)
    {
        var plainSegments = message.ThinkSegments.ToList();
        var htmlSegments = message.HtmlThinkSegments.ToList();
        var count = Math.Min(plainSegments.Count, htmlSegments.Count);

        for (var index = 0; index < count; index++)
        {
            if (string.IsNullOrWhiteSpace(plainSegments[index]))
                continue;

            yield return (plainSegments[index], htmlSegments[index]);
        }
    }

    private async Task ShowFullSizeImage(AppChatMessageFile file)
    {
        var parameters = new DialogParameters
        {
            ["ImageFile"] = file
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = true
        };

        await DialogService.ShowAsync<ImageViewerDialog>("Image Viewer", parameters, options);
    }

    private static string GetFileIcon(string contentType) =>
        ChatDisplayHelper.GetFileIcon(contentType);

    private static string FormatFileSize(long bytes) =>
        ChatDisplayHelper.FormatFileSize(bytes);

    private static bool IsImageFile(string contentType) =>
        ChatDisplayHelper.IsImageFile(contentType);

    private static string GetImageDataUrl(AppChatMessageFile file) =>
        ChatDisplayHelper.GetImageDataUrl(file);

    private static string GetAvatarText(string? name) =>
        ChatDisplayHelper.GetAvatarText(name);

    private string GetAssistantAvatarText(string? agentId) =>
        ChatDisplayHelper.GetAssistantAvatarText(Agents, agentId);

    private string? GetAssistantLabel(AppChatMessageViewModel message) =>
        ChatDisplayHelper.GetAssistantDisplayName(Agents, message.AgentId);

    private bool ShouldShowSpeakerLabel(AppChatMessageViewModel message) =>
        IsMultiAgent &&
        message.Role == AppChatRole.Assistant &&
        !string.IsNullOrWhiteSpace(GetSpeakerLabel(message));

    private string? GetSpeakerLabel(AppChatMessageViewModel message) =>
        GetAssistantLabel(message);

    private static Task<string> GetRawContentAsync(AppChatMessageViewModel message) =>
        Task.FromResult(message.RawContent ?? string.Empty);
}
