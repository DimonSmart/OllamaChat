@using ChatClient.Api.Client.Services.Agentic
@using System.Diagnostics
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@inject HarnessTraceSession TraceSession

<div class="session-state-drawer-layout">
    <div class="session-state-drawer-header">
        <MudText Typo="Typo.subtitle2">
            Trace (@snapshot.Runs.Count)
        </MudText>

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="1">
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       OnClick="Clear">
                Clear
            </MudButton>

            <MudTooltip Text="Close trace"
                        Placement="Placement.Left">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               aria-label="Close trace"
                               OnClick="CloseAsync" />
            </MudTooltip>
        </MudStack>
    </div>
    <div class="session-state-drawer-content">
        @if (snapshot.Runs.Count == 0)
        { <MudText Typo="Typo.body2" Class="mud-text-secondary">No trace runs yet</MudText> }
        else
        {
            <MudSelect T="string" Value="selectedRunId" ValueChanged="SelectRun" Dense="true" Label="Run">
                @foreach (var run in snapshot.Runs) { <MudSelectItem Value="@run.RunId">@RunLabel(run)</MudSelectItem> }
            </MudSelect>
            @if (SelectedRun is { } run)
            {
                <MudText Typo="Typo.caption" Class="mt-2">@run.Status · @((run.CompletedAt - run.StartedAt)?.ToString("g") ?? "Running") · @run.Spans.Count spans</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Trace: @run.TraceId</MudText>
                @if (run.IsTruncated) { <MudText Typo="Typo.caption" Color="Color.Warning">Trace truncated</MudText> }
                @foreach (var node in BuildForest(run)) { @RenderNode(node, 0) }
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private HarnessTraceSessionSnapshot snapshot = new([]);
    private string? selectedRunId;
    private bool followLatest = true;
    private HarnessTraceRunSnapshot? SelectedRun => snapshot.Runs.FirstOrDefault(run => run.RunId == selectedRunId);
    protected override void OnInitialized() { TraceSession.Changed += Changed; Refresh(); }
    private void Changed() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    private void Refresh() { snapshot = TraceSession.GetSnapshot(); if (followLatest || !snapshot.Runs.Any(run => run.RunId == selectedRunId)) selectedRunId = snapshot.Runs.FirstOrDefault()?.RunId; }
    private Task SelectRun(string runId) { selectedRunId = runId; followLatest = string.Equals(runId, snapshot.Runs.FirstOrDefault()?.RunId, StringComparison.Ordinal); return Task.CompletedTask; }
    private void Clear() { followLatest = true; TraceSession.Clear(); }
    private Task CloseAsync() => OnClose.InvokeAsync();
    private static string RunLabel(HarnessTraceRunSnapshot run) => $"Run {run.StartedAt.LocalDateTime:T} · {run.Status} · {run.Spans.Count} spans";
    private static IReadOnlyList<TraceNode> BuildForest(HarnessTraceRunSnapshot run)
    {
        var nodes = run.Spans.Select(span => new TraceNode(span)).ToDictionary(node => $"{node.Span.TraceId}/{node.Span.SpanId}"); var roots = new List<TraceNode>();
        foreach (var node in nodes.Values) { var parentKey = $"{node.Span.TraceId}/{node.Span.ParentSpanId}"; if (!string.IsNullOrEmpty(node.Span.ParentSpanId) && nodes.TryGetValue(parentKey, out var parent)) parent.Children.Add(node); else roots.Add(node); }
        Sort(roots); return roots;
    }
    private static void Sort(List<TraceNode> nodes) { nodes.Sort((left, right) => left.Span.StartedAt.CompareTo(right.Span.StartedAt)); foreach (var node in nodes) Sort(node.Children); }
    private RenderFragment RenderNode(TraceNode node, int depth) => builder =>
    {
        var sequence = 0; builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "style", $"margin-left:{depth * 16}px");
        builder.OpenElement(sequence++, "details"); builder.OpenElement(sequence++, "summary"); builder.AddContent(sequence++, SpanDisplayName(node.Span));
        var operation = node.Span.Tags.FirstOrDefault(tag => tag.Key == "gen_ai.operation.name")?.Value; if (operation is not null) builder.AddContent(sequence++, $" [{operation}]");
        builder.AddContent(sequence++, $" · {(node.Span.Duration?.ToString("g") ?? "Running")}"); builder.CloseElement();
        builder.AddContent(sequence++, RenderDetails(node.Span)); foreach (var child in node.Children) builder.AddContent(sequence++, RenderNode(child, depth + 1)); builder.CloseElement(); builder.CloseElement();
    };
    private static string SpanDisplayName(HarnessTraceSpanSnapshot span)
    {
        var operation = span.Tags.FirstOrDefault(tag => tag.Key == "gen_ai.operation.name")?.Value;
        var agentName = span.Tags.FirstOrDefault(tag => tag.Key == "gen_ai.agent.name")?.Value;
        if (!string.Equals(operation, "invoke_agent", StringComparison.Ordinal) || string.IsNullOrWhiteSpace(agentName)) return span.DisplayName;
        var prefix = $"invoke_agent {agentName}";
        if (!span.DisplayName.StartsWith(prefix + "(", StringComparison.Ordinal)) return span.DisplayName;
        var closing = span.DisplayName.IndexOf(')', prefix.Length + 1);
        return closing < 0 ? span.DisplayName : prefix + span.DisplayName[(closing + 1)..];
    }
    private RenderFragment RenderDetails(HarnessTraceSpanSnapshot span) => builder =>
    {
        var sequence = 0; builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "pa-2");
        builder.AddContent(sequence++, $"Source: {span.SourceName} · Kind: {span.Kind} · Started: {span.StartedAt.LocalDateTime:g} · Status: {span.StatusCode} {span.StatusDescription}");
        builder.OpenElement(sequence++, "div"); builder.AddContent(sequence++, $"Trace ID: {span.TraceId} · Span ID: {span.SpanId} · Parent Span ID: {span.ParentSpanId}"); builder.CloseElement();
        AddSection(builder, ref sequence, "Attributes", span.Tags.Select(tag => $"{tag.Key}: {tag.Value}"));
        AddSection(builder, ref sequence, "Events", span.Events.SelectMany(item => new[] { $"{item.Timestamp.LocalDateTime:g} · {item.Name}" }.Concat(item.Tags.Select(tag => $"  {tag.Key}: {tag.Value}"))));
        if (span.EventsTruncated) { builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "mud-text-warning"); builder.AddContent(sequence++, $"Events truncated — showing first {HarnessTraceSession.MaxEventsPerSpan}"); builder.CloseElement(); }
        AddSection(builder, ref sequence, "Links", span.Links.SelectMany(link => new[] { $"{link.TraceId} / {link.SpanId} · {link.TraceFlags}" }.Concat(link.Tags.Select(tag => $"  {tag.Key}: {tag.Value}"))));
        builder.CloseElement();
    };
    private static void AddSection(RenderTreeBuilder builder, ref int sequence, string title, IEnumerable<string> entries) { builder.OpenElement(sequence++, "details"); builder.OpenElement(sequence++, "summary"); builder.AddContent(sequence++, title); builder.CloseElement(); foreach (var entry in entries) { builder.OpenElement(sequence++, "div"); builder.AddContent(sequence++, entry); builder.CloseElement(); } builder.CloseElement(); }
    private sealed class TraceNode(HarnessTraceSpanSnapshot span) { public HarnessTraceSpanSnapshot Span { get; } = span; public List<TraceNode> Children { get; } = []; }
    public void Dispose() => TraceSession.Changed -= Changed;
}
