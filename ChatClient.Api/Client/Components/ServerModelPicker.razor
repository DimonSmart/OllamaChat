@using ChatClient.Api.Services
@using ChatClient.Domain.Models
@inject ILlmServerConfigService LlmServerConfigService
@inject IOllamaClientService OllamaService
@inject IOpenAIClientService OpenAIService
@inject IUserSettingsService UserSettingsService

<MudStack Spacing="1" Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" @attributes="Attributes" Style="@ContainerStyle">
    <MudSelect T="Guid?" Value="selectedServerId" ValueChanged="OnServerChanged" Placeholder="Server"
               Variant="@SelectVariant" Dense="true" Margin="@SelectMargin"
               Style="@SelectStyle"
               Text="@GetSelectedServerName()">
        @foreach (var server in servers)
        {
            <MudSelectItem Value="@server.Id">@server.Name</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string" Value="selectedModel" ValueChanged="OnModelChanged" Placeholder="Model"
               Variant="@SelectVariant" Disabled="@(!selectedServerId.HasValue || loading || loadError != null)" Dense="true" Margin="@SelectMargin"
               Style="@SelectStyle">
        @foreach (var model in models)
        {
            <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
        }
    </MudSelect>
    
    @if (ShowClearButton && (selectedServerId.HasValue || !string.IsNullOrEmpty(selectedModel)))
    {
        <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                       Size="Size.Small" 
                       Color="Color.Default"
                       OnClick="OnClearSelection"
                       title="Clear server and model selection"
                       Class="ml-1" />
    }
    
    @if (loading)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
    }
    else if (loadError != null)
    {
        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="ml-2" Title="@loadError" />
    }
</MudStack>

@code {
    [Parameter] public ServerModelSelection Value { get; set; } = new(null, null);
    [Parameter] public EventCallback<ServerModelSelection> ValueChanged { get; set; }
    [Parameter] public bool ShowClearButton { get; set; } = false;
    [Parameter] public bool UseDefaultsWhenUnset { get; set; } = true;
    [Parameter] public Variant SelectVariant { get; set; } = Variant.Filled;
    [Parameter] public Margin SelectMargin { get; set; } = Margin.None;
    [Parameter] public bool FillAvailableWidth { get; set; } = true;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> Attributes { get; set; } = [];

    private Guid? selectedServerId;
    private string? selectedModel;
    private List<LlmServerConfig> servers = [];
    private List<OllamaModel> models = [];
    private bool loading;
    private string? loadError;
    private string ContainerStyle => FillAvailableWidth ? "flex: 1; min-width: 0;" : "max-width: 600px; min-width: 0;";
    private string SelectStyle => FillAvailableWidth ? "min-width:120px; flex:1;" : "min-width:220px; flex:1 1 220px;";

    protected override async Task OnInitializedAsync()
    {
        servers = (await LlmServerConfigService.GetAllAsync()).ToList();
        if (Value.ServerId is null && string.IsNullOrEmpty(Value.ModelName))
        {
            if (UseDefaultsWhenUnset)
            {
                var settings = await UserSettingsService.GetSettingsAsync();
                var defaultModel = settings.DefaultModel;
                selectedServerId = defaultModel.ServerId;
                selectedModel = defaultModel.ModelName;
                if (selectedServerId.HasValue)
                    await LoadModelsAsync(selectedServerId.Value);
                EnsureSelectedModelIsAvailable();
                await NotifyValueChanged();
            }
            return;
        }
        selectedServerId = Value.ServerId;
        if (selectedServerId.HasValue)
            await LoadModelsAsync(selectedServerId.Value);
        if (!string.IsNullOrEmpty(Value.ModelName))
            selectedModel = Value.ModelName;
        EnsureSelectedModelIsAvailable();
    }

    private async Task OnServerChanged(Guid? serverId)
    {
        selectedServerId = serverId;
        selectedModel = null;
        models.Clear();
        if (serverId.HasValue)
        {
            await LoadModelsAsync(serverId.Value);
        }
        await NotifyValueChanged();
    }

    private async Task OnModelChanged(string? model)
    {
        selectedModel = model;
        await NotifyValueChanged();
    }

    private async Task OnClearSelection()
    {
        selectedServerId = null;
        selectedModel = null;
        models.Clear();
        await NotifyValueChanged();
    }

    private async Task NotifyValueChanged()
    {
        var selection = new ServerModelSelection(selectedServerId, selectedModel);
        Value = selection;
        await ValueChanged.InvokeAsync(selection);
    }

    private async Task LoadModelsAsync(Guid serverId)
    {
        try
        {
            loading = true;
            loadError = null;
            StateHasChanged();

            var server = servers.FirstOrDefault(s => s.Id == serverId);
            if (server is null)
            {
                throw new InvalidOperationException($"Server {serverId} not found.");
            }

            if (server.ServerType == ServerType.Azure)
            {
                models = LlmServerConfigHelper.GetConfiguredAzureDeploymentNames(server)
                    .Select(name => new OllamaModel { Name = name })
                    .ToList();
                return;
            }

            models = server.ServerType == ServerType.ChatGpt
                ? (await OpenAIService.GetAvailableModelsAsync(serverId)).Select(name => new OllamaModel { Name = name }).ToList()
                : (await OllamaService.GetModelsAsync(serverId)).ToList();

            models = models
                .OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            EnsureSelectedModelIsAvailable();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            models.Clear();
        }
        finally
        {
            loading = false;
        }
    }

    private void EnsureSelectedModelIsAvailable()
    {
        if (string.IsNullOrWhiteSpace(selectedModel))
            return;

        var exists = models.Any(m => string.Equals(m.Name, selectedModel, StringComparison.OrdinalIgnoreCase));
        if (!exists)
        {
            selectedModel = null;
        }
    }

    private string GetSelectedServerName()
    {
        if (!selectedServerId.HasValue)
            return string.Empty;
        
        var server = servers.FirstOrDefault(s => s.Id == selectedServerId.Value);
        return server?.Name ?? string.Empty;
    }
}
