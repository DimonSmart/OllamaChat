@using ChatClient.Api.Services
@using ChatClient.Domain.Models
@inject ILlmServerConfigService LlmServerConfigService
@inject IOllamaClientService OllamaService
@inject IOpenAIClientService OpenAIService
@inject IUserSettingsService UserSettingsService

<MudStack Spacing="1" Row="true" Wrap="@(IsCompact ? Wrap.NoWrap : Wrap.Wrap)" AlignItems="AlignItems.Center" @attributes="Attributes" Class="@PickerClass">
    @if (IsCompact)
    {
        <div class="server-model-picker__compact-control" @onkeydown="OnCompactPickerKeyDown">
            <MudMenu @bind-Open="compactPickerOpen"
                     Disabled="Disabled"
                     Dense="true"
                     Label="@GetCompactSelectionText()"
                     AriaLabel="Select server and model"
                     EndIcon="@Icons.Material.Filled.ArrowDropDown"
                     Variant="Variant.Text"
                     Size="Size.Small"
                     Class="server-model-picker__summary"
                     title="@GetCompactSelectionText()"
                     AnchorOrigin="@CompactAnchorOrigin"
                     TransformOrigin="@CompactTransformOrigin">
                <ChildContent>
                <MudStack Spacing="1" Class="pa-2 server-model-picker__compact-popover" @onkeydown="OnCompactPickerKeyDown">
                    <MudSelect T="Guid?" Value="selectedServerId" ValueChanged="OnServerChanged" Label="Server"
                               Variant="Variant.Text" Disabled="Disabled" Dense="true" Margin="Margin.Dense"
                               FullWidth="true"
                               Text="@GetSelectedServerName()">
                        @foreach (var server in servers)
                        {
                            <MudSelectItem Value="@server.Id">@server.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect @key="selectedServerId" T="string" Value="selectedModel" ValueChanged="OnModelChanged" Label="Model"
                               Variant="Variant.Text" Disabled="@(Disabled || !selectedServerId.HasValue || loading || loadError != null)" Dense="true" Margin="Margin.Dense"
                               FullWidth="true">
                        @foreach (var model in models)
                        {
                            <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
                </ChildContent>
            </MudMenu>
        </div>
    }
    else
    {
        <div class="server-model-picker__fields">
            <MudSelect T="Guid?" Value="selectedServerId" ValueChanged="OnServerChanged" Placeholder="Server"
                       Variant="@SelectVariant" Disabled="Disabled" Dense="true" Margin="@SelectMargin" Class="@SelectClass"
                       Text="@GetSelectedServerName()">
                @foreach (var server in servers)
                {
                    <MudSelectItem Value="@server.Id">@server.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect @key="selectedServerId" T="string" Value="selectedModel" ValueChanged="OnModelChanged" Placeholder="Model"
                       Variant="@SelectVariant" Disabled="@(Disabled || !selectedServerId.HasValue || loading || loadError != null)" Dense="true" Margin="@SelectMargin" Class="@SelectClass">
                @foreach (var model in models)
                {
                    <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    }

    @if (!IsCompact && ShowClearButton && (selectedServerId.HasValue || !string.IsNullOrEmpty(selectedModel)))
    {
        <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                       Size="Size.Small" 
                       Color="Color.Default"
                       OnClick="OnClearSelection"
                       title="Clear server and model selection"
                       Class="ml-1" />
    }
    
    @if (loading)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
    }
    else if (loadError != null)
    {
        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="ml-2" Title="@loadError" />
    }
</MudStack>

@code {
    [Parameter] public ServerModelSelection Value { get; set; } = new(null, null);
    [Parameter] public EventCallback<ServerModelSelection> ValueChanged { get; set; }
    [Parameter] public bool ShowClearButton { get; set; } = false;
    [Parameter] public bool UseDefaultsWhenUnset { get; set; } = true;
    [Parameter] public Variant SelectVariant { get; set; } = Variant.Filled;
    [Parameter] public Margin SelectMargin { get; set; } = Margin.Dense;
    [Parameter] public bool FillAvailableWidth { get; set; } = true;
    [Parameter] public ServerModelPickerPresentation Presentation { get; set; } = ServerModelPickerPresentation.Form;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> Attributes { get; set; } = [];

    private Guid? selectedServerId;
    private string? selectedModel;
    private List<LlmServerConfig> servers = [];
    private List<OllamaModel> models = [];
    private bool loading;
    private string? loadError;
    private bool compactPickerOpen;
    private bool IsCompact => Presentation is ServerModelPickerPresentation.Toolbar or ServerModelPickerPresentation.Composer;
    private Origin CompactAnchorOrigin => Presentation == ServerModelPickerPresentation.Composer
        ? Origin.TopCenter
        : Origin.BottomCenter;
    private Origin CompactTransformOrigin => Presentation == ServerModelPickerPresentation.Composer
        ? Origin.BottomCenter
        : Origin.TopCenter;
    private string PickerClass => $"{(IsCompact ? "server-model-picker--compact" : "server-model-picker--form")} {(FillAvailableWidth ? "server-model-picker--fluid" : "server-model-picker--bounded")} {Class}";
    private string SelectClass => FillAvailableWidth
        ? "server-model-picker__select--fluid"
        : "server-model-picker__select--bounded";

    protected override void OnParametersSet()
    {
        if (Disabled)
            compactPickerOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        servers = (await LlmServerConfigService.GetAllAsync()).ToList();
        if (Value.ServerId is null && string.IsNullOrEmpty(Value.ModelName))
        {
            if (UseDefaultsWhenUnset)
            {
                var settings = await UserSettingsService.GetSettingsAsync();
                var defaultModel = settings.DefaultModel;
                selectedServerId = defaultModel.ServerId;
                selectedModel = defaultModel.ModelName;
                if (selectedServerId.HasValue)
                    await LoadModelsAsync(selectedServerId.Value);
                EnsureSelectedModelIsAvailable();
                await NotifyValueChanged();
            }
            return;
        }
        selectedServerId = Value.ServerId;
        if (selectedServerId.HasValue)
            await LoadModelsAsync(selectedServerId.Value);
        if (!string.IsNullOrEmpty(Value.ModelName))
            selectedModel = Value.ModelName;
        EnsureSelectedModelIsAvailable();
    }

    private async Task OnServerChanged(Guid? serverId)
    {
        selectedServerId = serverId;
        selectedModel = null;
        models.Clear();
        if (serverId.HasValue)
        {
            await LoadModelsAsync(serverId.Value);
        }
        await NotifyValueChanged();
    }

    private async Task OnModelChanged(string? model)
    {
        selectedModel = model;
        compactPickerOpen = false;
        await NotifyValueChanged();
    }

    private void OnCompactPickerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            compactPickerOpen = false;
    }

    private async Task OnClearSelection()
    {
        selectedServerId = null;
        selectedModel = null;
        models.Clear();
        await NotifyValueChanged();
    }

    private async Task NotifyValueChanged()
    {
        var selection = new ServerModelSelection(selectedServerId, selectedModel);
        Value = selection;
        await ValueChanged.InvokeAsync(selection);
    }

    private async Task LoadModelsAsync(Guid serverId)
    {
        try
        {
            loading = true;
            loadError = null;
            StateHasChanged();

            var server = servers.FirstOrDefault(s => s.Id == serverId);
            if (server is null)
            {
                throw new InvalidOperationException($"Server {serverId} not found.");
            }

            if (server.ServerType == ServerType.Azure)
            {
                models = LlmServerConfigHelper.GetConfiguredAzureDeploymentNames(server)
                    .Select(name => new OllamaModel { Name = name })
                    .ToList();
                return;
            }

            models = server.ServerType == ServerType.ChatGpt
                ? (await OpenAIService.GetAvailableModelsAsync(serverId)).Select(name => new OllamaModel { Name = name }).ToList()
                : (await OllamaService.GetModelsAsync(serverId)).ToList();

            models = models
                .OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            EnsureSelectedModelIsAvailable();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            models.Clear();
        }
        finally
        {
            loading = false;
        }
    }

    private void EnsureSelectedModelIsAvailable()
    {
        if (string.IsNullOrWhiteSpace(selectedModel))
            return;

        var exists = models.Any(m => string.Equals(m.Name, selectedModel, StringComparison.OrdinalIgnoreCase));
        if (!exists)
        {
            selectedModel = null;
        }
    }

    private string GetSelectedServerName()
    {
        if (!selectedServerId.HasValue)
            return string.Empty;
        
        var server = servers.FirstOrDefault(s => s.Id == selectedServerId.Value);
        return server?.Name ?? string.Empty;
    }

    private string GetCompactSelectionText()
    {
        var serverName = GetSelectedServerName();
        var serverLabel = string.IsNullOrWhiteSpace(serverName) ? "Server" : serverName;
        var modelLabel = string.IsNullOrWhiteSpace(selectedModel) ? "Select model" : selectedModel;
        return string.IsNullOrWhiteSpace(serverName) && string.IsNullOrWhiteSpace(selectedModel)
            ? "Select model"
            : $"{serverLabel} · {modelLabel}";
    }
}
